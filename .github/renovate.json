{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "customManagers:biomeVersions",
    ":enableVulnerabilityAlerts"
  ],
  "labels": ["dependencies", "renovate", "bot"],
  "schedule": ["on the 1st and 15th day of the month"],
  "minimumReleaseAge": "4 days",
  "rangeStrategy": "pin",
  "pinDigests": true,
  "automergeStrategy": "squash",
  "assigneesFromCodeOwners": true,
  "reviewersFromCodeOwners": true,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "labels": ["security", "vulnerability"]
  },
  "osvVulnerabilityAlerts": true,
  "includePaths": ["app/**", "web/**", ".github/**"],
  "packageRules": [
    {
      "matchFileNames": ["web/**"],
      "addLabels": ["web"]
    },
    {
      "matchFileNames": ["app/**"],
      "addLabels": ["app"]
    },
    {
      "matchManagers": ["pub"],
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "addLabels": ["pin-update"]
    },
    {
      "matchManagers": ["pub"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "addLabels": ["patch-update"]
    },
    {
      "matchManagers": ["pub"],
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "automergeType": "pr",
      "addLabels": ["minor-update"]
    },
    {
      "matchManagers": ["pub"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"],
      "automerge": false
    },
    {
      "matchManagers": ["pub"],
      "matchDepNames": [
        "flutter_riverpod",
        "riverpod_annotation",
        "shadcn_ui",
        "freezed_annotation"
      ],
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update", "review-required"],
      "automerge": false
    },
    {
      "matchManagers": ["pub"],
      "matchDepNames": ["riverpod_lint"],
      "allowedVersions": "<3.1.4",
      "description": "Hold below 3.1.4: it requires analyzer ^12, which no stable freezed release supports yet, breaking pub version solving. Lift once freezed ships a stable analyzer-12 release."
    },
    {
      "matchManagers": ["pub"],
      "matchDepNames": ["riverpod_generator"],
      "allowedVersions": "<4.0.4",
      "description": "Hold below 4.0.4: it requires analyzer ^12, which no stable freezed release supports yet, breaking pub version solving. Lift once freezed ships a stable analyzer-12 release."
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "addLabels": ["patch-update"]
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "automergeType": "pr",
      "addLabels": ["minor-update"]
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update", "review-required"],
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "pinDigest", "patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "addLabels": ["ci"]
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update", "review-required"],
      "automerge": false
    },
    {
      "matchManagers": ["gradle"],
      "matchDepNames": ["dev.flutter.flutter-plugin-loader"],
      "enabled": false,
      "description": "Provided by the Flutter SDK via includeBuild, not a published Maven artifact. Update by bumping Flutter, not by Renovate."
    }
  ]
}
