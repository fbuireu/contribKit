{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "customManagers:biomeVersions",
    ":enableVulnerabilityAlerts"
  ],
  "labels": ["dependencies", "renovate", "bot"],
  "schedule": ["on the 1st and 15th day of the month"],
  "minimumReleaseAge": "4 days",
  "rangeStrategy": "pin",
  "pinDigests": true,
  "automergeStrategy": "squash",
  "assigneesFromCodeOwners": true,
  "reviewersFromCodeOwners": true,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "labels": ["security", "vulnerability"]
  },
  "osvVulnerabilityAlerts": true,
  "includePaths": ["app/**", "web/**", ".github/**"],
  "packageRules": [
    {
      "matchFileNames": ["web/**"],
      "addLabels": ["web"]
    },
    {
      "matchFileNames": ["app/**"],
      "addLabels": ["app"]
    },
    {
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "addLabels": ["pin-update"]
    },
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "addLabels": ["patch-update"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "automergeType": "pr",
      "addLabels": ["minor-update"]
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major-update"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["ci"]
    },
    {
      "matchManagers": ["pub"],
      "matchPackageNames": [
        "/^riverpod/",
        "freezed",
        "freezed_annotation",
        "json_serializable",
        "json_annotation",
        "build_runner",
        "source_gen",
        "analyzer"
      ],
      "groupName": "flutter codegen",
      "automerge": false,
      "addLabels": ["codegen"]
    },
    {
      "matchManagers": ["pub"],
      "matchPackageNames": ["purchases_flutter", "purchases_ui_flutter"],
      "groupName": "purchases"
    },
    {
      "matchManagers": ["gradle"],
      "matchDepNames": ["dev.flutter.flutter-plugin-loader"],
      "enabled": false
    }
  ]
}
