{
	"name": "contribkit-web",
	"version": "1.16.2",
	"private": true,
	"description": "Visualize and export your GitHub contribution calendar: web app",
	"keywords": [
		"github",
		"contributions",
		"calendar",
		"svg",
		"astro",
		"open-source",
		"developer-tools",
		"github-stats",
		"typescript",
		"cloudflare-workers"
	],
	"author": "Ferran Buireu <contact@contribkit.app>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fbuireu/contribKit.git",
		"directory": "web"
	},
	"homepage": "https://contribkit.app",
	"bugs": {
		"url": "https://github.com/fbuireu/contribKit/issues"
	},
	"type": "module",
	"engines": {
		"node": "26.7.0"
	},
	"scripts": {
		"types": "wrangler types",
		"dev": "pnpm types && astro dev",
		"dev:open": "pnpm dev --open",
		"wrangler:dev": "pnpm types && pnpm build && wrangler dev",
		"build": "pnpm types && astro build",
		"preview": "astro preview",
		"sync": "astro sync",
		"lint": "biome lint --no-errors-on-unmatched",
		"lint:all": "pnpm lint . ../docs ../.github",
		"lint:all:fix": "pnpm lint:all --fix",
		"lint:changed": "pnpm lint --write --changed",
		"format": "biome check --write --no-errors-on-unmatched",
		"format:all": "pnpm format . ../docs ../.github",
		"format:changed": "pnpm format --changed",
		"format:check": "biome check --no-errors-on-unmatched . ../docs ../.github",
		"typecheck": "pnpm types && tsc --project . --noEmit",
		"test:ut": "vitest run --logHeapUsage",
		"test:ut:watch": "vitest --logHeapUsage",
		"test:ut:coverage": "pnpm test:ut --coverage",
		"test:ut:changed": "pnpm test:ut --changed origin/main",
		"test:docs": "pnpm test:ut ../docs/docs-consistency.test.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "pnpm test:e2e --ui",
		"verify:static": "pnpm format:check && pnpm typecheck && pnpm check",
		"verify": "pnpm verify:static && pnpm test:ut:coverage",
		"verify:changed": "pnpm verify:static && pnpm test:ut:changed",
		"check": "pnpm types && astro check"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.3.1",
		"@astrojs/sitemap": "3.7.4",
		"astro": "7.3.2",
		"vanilla-cookieconsent": "3.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/ts-plugin": "1.10.11",
		"@biomejs/biome": "2.5.12",
		"@playwright/test": "1.63.0",
		"@semantic-release/changelog": "7.0.0",
		"@semantic-release/git": "11.0.1",
		"@semantic-release/github": "12.0.9",
		"@semantic-release/npm": "13.1.5",
		"@types/node": "26.2.0",
		"@vitest/coverage-istanbul": "5.0.0",
		"happy-dom": "20.14.0",
		"semantic-release": "25.0.9",
		"semantic-release-monorepo": "8.0.2",
		"typescript": "6.0.3",
		"vitest": "5.0.0",
		"wrangler": "4.130.0"
	}
}
