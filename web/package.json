{
	"name": "contribkit-web",
	"description": "Visualize and export your GitHub contribution calendar — web app",
	"keywords": [
		"github",
		"contributions",
		"calendar",
		"svg",
		"astro",
		"android",
		"ios",
		"open-source",
		"developer-tools",
		"github-stats"
	],
	"author": "Ferran Buireu <contact@contribkit.app>",
	"version": "1.6.1",
	"type": "module",
	"packageManager": "pnpm@11.3.0",
	"engines": {
		"node": "v26.2.0"
	},
	"scripts": {
		"types": "wrangler types",
		"dev": "pnpm types && astro dev --open",
		"wrangler:dev": "pnpm types && pnpm build && wrangler dev",
		"build": "pnpm types && astro build",
		"preview": "astro preview",
		"sync": "astro sync",
		"lint:astro": "pnpm types && astro check",
		"test": "vitest --passWithNoTests --logHeapUsage",
		"test:changed": "pnpm test --bail --findRelatedTests",
		"format": "biome check --write --no-errors-on-unmatched",
		"format:changed": "pnpm format --changed",
		"format:all": "pnpm format .",
		"lint": "biome lint --no-errors-on-unmatched",
		"lint:all": "pnpm lint .",
		"lint:changed": "pnpm lint --write --changed",
		"lint:ts:typecheck": "pnpm types && tsc --project . --noEmit"
	},
	"dependencies": {
		"@astrojs/cloudflare": "13.6.0",
		"@astrojs/sitemap": "3.7.3",
		"astro": "6.4.2",
		"vanilla-cookieconsent": "3.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.9",
		"@astrojs/ts-plugin": "1.10.9",
		"@biomejs/biome": "2.4.16",
		"@semantic-release/changelog": "6.0.3",
		"@semantic-release/exec": "7.1.0",
		"@semantic-release/git": "10.0.1",
		"@semantic-release/github": "12.0.8",
		"@types/node": "25.9.1",
		"@vitest/coverage-istanbul": "4.1.7",
		"semantic-release": "25.0.3",
		"semantic-release-monorepo": "8.0.2",
		"typescript": "6.0.3",
		"vitest": "4.1.7",
		"wrangler": "4.95.0"
	}
}
