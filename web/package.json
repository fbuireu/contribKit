{
	"name": "contribkit-web",
	"description": "Visualize and export your GitHub contribution calendar — web app",
	"keywords": [
		"github",
		"contributions",
		"calendar",
		"svg",
		"astro",
		"android",
		"ios",
		"open-source",
		"developer-tools",
		"github-stats"
	],
	"author": "Ferran Buireu <contact@contribkit.app>",
	"version": "1.12.5",
	"private": true,
	"type": "module",
	"engines": {
		"node": "26.7.0"
	},
	"scripts": {
		"types": "wrangler types",
		"dev": "pnpm types && astro dev --open",
		"wrangler:dev": "pnpm types && pnpm build && wrangler dev",
		"build": "pnpm types && astro build",
		"preview": "astro preview",
		"sync": "astro sync",
		"lint:astro": "pnpm types && astro check",
		"test": "vitest --passWithNoTests --logHeapUsage",
		"test:docs": "vitest run ../docs/docs-consistency.test.ts",
		"test:changed": "pnpm test --bail --findRelatedTests",
		"test:e2e": "playwright test",
		"test:e2e:ui": "pnpm test:e2e --ui",
		"format": "biome check --write --no-errors-on-unmatched",
		"format:changed": "pnpm format --changed",
		"format:all": "pnpm format . ../docs",
		"format:check": "biome check --no-errors-on-unmatched . ../docs",
		"lint": "biome lint --no-errors-on-unmatched",
		"lint:all": "pnpm lint . ../docs",
		"lint:changed": "pnpm lint --write --changed",
		"lint:ts:typecheck": "pnpm types && tsc --project . --noEmit"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.2.1",
		"@astrojs/sitemap": "3.7.3",
		"@logtail/edge": "0.5.8",
		"astro": "7.2.1",
		"vanilla-cookieconsent": "3.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/ts-plugin": "1.10.10",
		"@biomejs/biome": "2.5.8",
		"@playwright/test": "1.62.1",
		"@semantic-release/changelog": "7.0.0",
		"@semantic-release/exec": "7.1.0",
		"@semantic-release/git": "11.0.1",
		"@semantic-release/github": "12.0.9",
		"@types/node": "26.2.0",
		"@vitest/coverage-istanbul": "4.1.10",
		"happy-dom": "20.11.2",
		"semantic-release": "25.0.9",
		"semantic-release-monorepo": "8.0.2",
		"typescript": "6.0.3",
		"vitest": "4.1.10",
		"wrangler": "4.121.0"
	}
}
