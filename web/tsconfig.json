{
	"extends": ["astro/tsconfigs/strict"],
	"include": [".astro/types.d.ts", "**/*", "../docs/**/*.ts"],
	"exclude": ["dist"],
	"compilerOptions": {
		"types": [],
		"paths": {
			"vitest": ["./node_modules/vitest"],
			"@shared/*": ["../shared/*"],
			"@domain/*": ["./src/domain/*"],
			"@application/*": ["./src/application/*"],
			"@infrastructure/*": ["./src/infrastructure/*"],
			"@ui/*": ["./src/ui/*"],
			"@assets/*": ["./src/assets/*"]
		},
		"plugins": [{ "name": "@astrojs/ts-plugin" }]
	}
}
