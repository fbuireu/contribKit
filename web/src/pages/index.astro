---
import { ContributionsEndpoint, logContributionsFailure } from "@application/http/log-contributions-failure";
import { DaySource, daySourceFor, resolveViewerIdentity } from "@application/use-cases/resolve-initial-view";
import type { ContributionDay } from "@domain/entities/types";
import { buildGridFromApi } from "@domain/services/calendar-grid";
import { statsWithScrapedTotal } from "@domain/services/contribution-stats";
import { CellShape, DEFAULT_CELL_SHAPE } from "@domain/value-objects/cell-shape";
import { PALETTES } from "@domain/value-objects/palette";
import { loggerFor } from "@infrastructure/logging/better-stack-logger";
import BaseLayout from "@ui/components/core/layouts/BaseLayout.astro";
import type { Metadata } from "@ui/components/core/seo/types";
import Customize from "@ui/components/customize/Customize.astro";
import Export from "@ui/components/export/Export.astro";
import CellTooltip from "@ui/components/grid/CellTooltip.astro";
import { generateData } from "@ui/components/grid/calendar";
import { EXPORT_GRID_PRESET, HERO_GRID_PRESET } from "@ui/components/grid/grid-presets";
import { renderCalendarString } from "@ui/components/grid/render-svg";
import Hero from "@ui/components/hero/Hero.astro";
import HowItWorks from "@ui/components/how-it-works/HowItWorks.astro";
import Widget from "@ui/components/widget/Widget.astro";
import { contributionError } from "@ui/utils/contribution-errors";
import { USERNAME_COOKIE } from "@ui/utils/cookie";
import { loadInitial } from "./_contributions";

const SITE_URL = (Astro.site ?? Astro.url).origin;
const OG_IMAGE = `${SITE_URL}/og.png`;
const OG_IMAGE_ALT = "ContribKit — GitHub contribution calendar with custom palette";
const TITLE = "ContribKit — Your GitHub activity, your aesthetic.";
const DESCRIPTION = "Visualize, customize, and export your GitHub contribution calendar — no token required.";
const CLASSIC = [...PALETTES.github.colors];

const metadata: Metadata = {
	title: TITLE,
	description: DESCRIPTION,
	url: SITE_URL,
	image: OG_IMAGE,
	imageAlt: OG_IMAGE_ALT,
};

const SCHEMA = [
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		name: "ContribKit",
		url: SITE_URL,
		description: DESCRIPTION,
	},
	{
		"@context": "https://schema.org",
		"@type": "SoftwareApplication",
		name: "ContribKit",
		description: DESCRIPTION,
		applicationCategory: "DeveloperApplication",
		operatingSystem: "iOS, Android, Web",
		offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
		url: SITE_URL,
		image: OG_IMAGE,
		author: { "@type": "Person", name: "Ferran Buireu", url: "https://github.com/fbuireu" },
	},
];

const { username, isExplicit, cacheControl } = resolveViewerIdentity({
	requestedUsername: Astro.url.searchParams.get("user"),
	savedUsername: Astro.cookies.get(USERNAME_COOKIE)?.value,
});
const currentYear = new Date().getFullYear();
const requestedYear = Astro.url.searchParams.get("year");

const initial = await loadInitial({ username, year: requestedYear });
const resolvedYear = initial.ok ? initial.data.year : currentYear;

if (!initial.ok) {
	logContributionsFailure({
		logger: loggerFor(Astro.locals),
		username,
		kind: initial.kind,
		reason: initial.message,
		status: initial.status,
		endpoint: ContributionsEndpoint.Page,
	});
}

let days: ContributionDay[];
let heroError: string | null = null;
switch (daySourceFor({ loaded: initial.ok, isExplicit })) {
	case DaySource.Loaded:
		days = initial.ok ? initial.data.days : [];
		break;
	case DaySource.Empty:
		days = buildGridFromApi({ days: [], year: currentYear });
		heroError = initial.ok ? null : contributionError(initial.status);
		break;
	default:
		days = generateData();
}

const stats = statsWithScrapedTotal({
	days,
	scrapedTotal: initial.ok ? initial.data.total : null,
});

const heroSVG = renderCalendarString({
	days,
	palette: CLASSIC,
	shape: CellShape.Rounded,
	...HERO_GRID_PRESET,
	showLabels: true,
});
const exportSvg = renderCalendarString({
	days,
	palette: CLASSIC,
	shape: DEFAULT_CELL_SHAPE,
	...EXPORT_GRID_PRESET,
	showLabels: false,
});

const initialDaysForClient = days;

Astro.response.headers.set("Cache-Control", cacheControl);
---

<BaseLayout metadata={metadata}>
  <Hero heroSVG={heroSVG} stats={stats} palette={CLASSIC} username={username} year={resolvedYear} error={heroError} />
  <HowItWorks />
  <Customize />
  <Export exportSvg={exportSvg} />
  <Widget />
  <CellTooltip />
</BaseLayout>

<script is:inline define:vars={{ initialDaysForClient }}>
  window.__INITIAL_DAYS__ = initialDaysForClient;
</script>

<script is:inline type="application/ld+json" set:html={JSON.stringify(SCHEMA)} />

<script>
import { initPage } from '@ui/utils/page-init';
initPage();
</script>
