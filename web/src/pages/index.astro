---
import { fetchContributions } from "@application/use-cases/fetch-contributions";
import { PALETTES } from "@domain/value-objects/palette";
import { DEFAULT_SHAPE_KIND } from "@domain/value-objects/shape";
import { DEFAULT_USERNAME, isUsername, parseUsername } from "@domain/value-objects/username";
import { createGithubHtmlContributionsRepository } from "@infrastructure/github/create-github-html-contributions-repository";
import CellTip from "@ui/components/CellTip.astro";
import Customize from "@ui/components/Customize.astro";
import type { Metadata } from "@ui/components/core/metadata";
import Export from "@ui/components/Export.astro";
import Hero from "@ui/components/Hero.astro";
import HowItWorks from "@ui/components/HowItWorks.astro";
import BaseLayout from "@ui/components/layouts/BaseLayout.astro";
import Widget from "@ui/components/Widget.astro";
import { buildGridFromApi, type Cell, generateData, summarize } from "@ui/lib/calendar-utils";
import { contributionError } from "@ui/lib/contribution-errors";
import { loadInitialContributions } from "@ui/lib/load-initial-contributions";
import { renderCalendarString } from "@ui/lib/render-svg";

const SITE_URL = "https://contribkit.app";
const OG_IMAGE = `${SITE_URL}/og.png`;
const OG_IMAGE_ALT = "ContribKit — GitHub contribution calendar with custom palette";
const TITLE = "ContribKit — Your GitHub activity, your aesthetic.";
const DESCRIPTION = "Visualize, customize, and export your GitHub contribution calendar — no token required.";
const CLASSIC = [...PALETTES.github.colors];

const metadata: Metadata = {
	title: TITLE,
	description: DESCRIPTION,
	url: SITE_URL,
	image: OG_IMAGE,
	imageAlt: OG_IMAGE_ALT,
};

const SCHEMA = [
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		name: "ContribKit",
		url: SITE_URL,
		description: DESCRIPTION,
	},
	{
		"@context": "https://schema.org",
		"@type": "SoftwareApplication",
		name: "ContribKit",
		description: DESCRIPTION,
		applicationCategory: "DeveloperApplication",
		operatingSystem: "iOS, Android, Web",
		offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
		url: SITE_URL,
		image: OG_IMAGE,
		author: { "@type": "Person", name: "Ferran Buireu", url: "https://github.com/fbuireu" },
	},
];

const requestedUsername = Astro.url.searchParams.get("user")?.trim();
const savedRaw = Astro.cookies.get("ck_user")?.value?.trim();
const savedUsername = savedRaw && isUsername(parseUsername(savedRaw)) ? savedRaw : undefined;
const username = requestedUsername || savedUsername || DEFAULT_USERNAME;
const isExplicit = Boolean(requestedUsername || savedUsername);
const currentYear = new Date().getFullYear();
const requestedYear = Astro.url.searchParams.get("year");

const loadContributions = fetchContributions(createGithubHtmlContributionsRepository());
const initial = await loadInitialContributions({ loadContributions, username, year: requestedYear });
const resolvedYear = initial.ok ? initial.data.year : currentYear;

let cells: Cell[];
let heroError: string | null = null;
if (initial.ok) {
	cells = initial.data.cells;
} else if (isExplicit) {
	cells = buildGridFromApi([], currentYear);
	heroError = contributionError(initial.status);
} else {
	cells = generateData(7);
}

const summary = summarize(cells);
if (initial.ok && initial.data.total) summary.count = initial.data.total;

const heroSVG = renderCalendarString({ cells, palette: CLASSIC, shape: "rounded", size: 13, gap: 3, showLabels: true });
const exportSvg = renderCalendarString({
	cells,
	palette: CLASSIC,
	shape: DEFAULT_SHAPE_KIND,
	size: 10,
	gap: 2,
	showLabels: false,
});

const initialCellsForClient = cells.map((cell) => ({
	date: cell.date,
	level: cell.level,
	count: cell.count ?? null,
}));

Astro.response.headers.set(
	"Cache-Control",
	requestedUsername ? "private, max-age=3600, stale-while-revalidate=86400" : "private, no-store",
);
---

<BaseLayout metadata={metadata}>
  <Hero heroSVG={heroSVG} summary={summary} palette={CLASSIC} username={username} year={resolvedYear} error={heroError} />
  <HowItWorks />
  <Customize />
  <Export exportSvg={exportSvg} />
  <Widget />
  <CellTip />
</BaseLayout>

<script is:inline define:vars={{ initialCellsForClient }}>
  window.__INITIAL_CELLS__ = initialCellsForClient;
</script>

<script is:inline type="application/ld+json" set:html={JSON.stringify(SCHEMA)} />

<script>
import { initPage } from '@ui/lib/page-init';
initPage();
</script>
