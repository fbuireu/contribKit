  </head>
  <body>
    <TopNav />
    <Hero heroSVG={heroSVG} summary={summary} palette={CLASSIC} />
    <HowItWorks />
    <Customize />
    <Export exportPNGSVG={exportPNGSVG} />
    <Widget />
    <Footer />
    <div popover="manual" id="cell-tip" class="cell-tip" role="tooltip"></div>
  </body>
</html>

<script is:inline define:vars={{ initialCellsForClient, initialUsername: DEFAULT_USERNAME }}>
  window.__INITIAL_CELLS__ = initialCellsForClient;
  window.__INITIAL_USERNAME__ = initialUsername;
</script>

<script>
// @ts-nocheck
import { TOTALS_PER_LEVEL, toIsoDate, formatContribLabel } from '../ui/lib/contribution';

// ─── Palettes ──────────────────────────────────────────────────────────────
const PALETTES = {
  github:      ['#161B22','#0E4429','#006D32','#26A641','#39D353'],
  catppuccin:  ['#1E1E2E','#313244','#89B4FA','#74C7EC','#CBA6F7'],
  nord:        ['#2E3440','#3B4252','#5E81AC','#81A1C1','#88C0D0'],
  dracula:     ['#282A36','#44475A','#6272A4','#BD93F9','#FF79C6'],
  gruvbox:     ['#282828','#3C3836','#D79921','#D65D0E','#CC241D'],
  sunset:      ['#1A1A2E','#4A1942','#C9485B','#ED8936','#FECB2F'],
  tokyonight:  ['#1A1B26','#24283B','#7AA2F7','#7DCFFF','#BB9AF7'],
  onedark:     ['#282C34','#3E4451','#61AFEF','#56B6C2','#C678DD'],
  rosepine:    ['#191724','#26233A','#9CCFD8','#EB6F92','#C4A7E7'],
