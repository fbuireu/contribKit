  monokai:     ['#272822','#3E3D32','#A6E22E','#E6DB74','#F92672'],
};
const PALETTE_LIST = [
  { key:'github',     name:'GitHub',       swatches:PALETTES.github },
  { key:'catppuccin', name:'Catppuccin',   swatches:PALETTES.catppuccin },
  { key:'nord',       name:'Nord',         swatches:PALETTES.nord },
  { key:'dracula',    name:'Dracula',      swatches:PALETTES.dracula },
  { key:'gruvbox',    name:'Gruvbox',      swatches:PALETTES.gruvbox },
  { key:'sunset',     name:'Sunset',       swatches:PALETTES.sunset },
  { key:'tokyonight', name:'Tokyo Night',  swatches:PALETTES.tokyonight },
  { key:'onedark',    name:'One Dark',     swatches:PALETTES.onedark },
  { key:'rosepine',   name:'Rosé Pine',    swatches:PALETTES.rosepine },
  { key:'solarized',  name:'Solarized',    swatches:PALETTES.solarized },
  { key:'monokai',    name:'Monokai',      swatches:PALETTES.monokai },
];
const SHAPES = ['rounded','square','circle','dot','hex'];

// ─── Same deterministic data (same seed/anchor as server) ─────────────────
// Mirrors src/ui/lib/mulberry.ts (can't be imported here — is:inline script).
const WEYL_INCREMENT = 0x6d2b79f5;
const FIRST_MIX_SHIFT = 15;
const FIRST_ODD_MASK = 1;
const SECOND_MIX_SHIFT = 7;
const SECOND_ODD_MASK = 61;
const FINAL_MIX_SHIFT = 14;
const UINT32_RANGE = 0x1_0000_0000;
function mulberry32(seed) {
  let state = seed;
  return () => {
    state += WEYL_INCREMENT;
    let t = state;
    t = Math.imul(t ^ (t >>> FIRST_MIX_SHIFT), t | FIRST_ODD_MASK);
    t ^= t + Math.imul(t ^ (t >>> SECOND_MIX_SHIFT), t | SECOND_ODD_MASK);
    return ((t ^ (t >>> FINAL_MIX_SHIFT)) >>> 0) / UINT32_RANGE;
  };
}
function generateData(seed) {
  const rand = mulberry32(seed);
  const cells = [];
  const today = new Date(2026, 4, 17);
  const end = new Date(today);
  end.setDate(end.getDate() + (6 - end.getDay()));
  const totalDays = 53 * 7;
  const start = new Date(end);
  start.setDate(start.getDate() - (totalDays - 1));
  for (let i = 0; i < totalDays; i++) {
    const d = new Date(start);
    d.setDate(start.getDate() + i);
    const dow = d.getDay();
    const progress = i / totalDays;
    let base = 0.35 + progress * 0.5;
    if (dow === 0 || dow === 6) base *= 0.55;
    const cluster = Math.sin(i / 9) * 0.25 + Math.sin(i / 23) * 0.2;
    const r = rand();
    let score = base + cluster + (r - 0.5) * 0.6;
    if (rand() < 0.08) score -= 0.6;
    let level = 0;
    if (score >= 0.2) level = 1;
    if (score >= 0.45) level = 2;
    if (score >= 0.7) level = 3;
    if (score >= 0.95) level = 4;
    cells.push({ date: d, level });
  }
  return cells;
}
function rehydrateCells(arr) {
  return arr.map(({ date, level, count }) => ({
    date: new Date(date + 'T12:00:00'),
    level,
    count: count ?? null,
  }));
}
const CELLS = Array.isArray(window.__INITIAL_CELLS__) && window.__INITIAL_CELLS__.length
  ? rehydrateCells(window.__INITIAL_CELLS__)
  : generateData(7);

// ─── SVG calendar renderer ────────────────────────────────────────────────
function renderCalendarSVG(cells, palette, shape, size, gap, showLabels) {
  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const DOW = ['Mon','Wed','Fri'];
  const weeks = [];
  for (let w = 0; w < 53; w++) weeks.push(cells.slice(w * 7, w * 7 + 7));
  const monthLabels = [];
  let lastMonth = -1;
  weeks.forEach((week, w) => {
    if (!week[0]) return;
    const m = week[0].date.getMonth();
    if (m !== lastMonth && week[0].date.getDate() <= 7) {
      monthLabels.push({ w, label: MONTHS[m] });
      lastMonth = m;
    }
  });
  const cellW = size + gap;
  const labelW = showLabels ? 28 : 0;
  const labelH = showLabels ? 18 : 0;
  const padX = 12, padY = 12;
  const totalW = 53 * cellW + labelW + padX * 2;
  const totalH = 7 * cellW + labelH + padY * 2;
  const radius = shape === 'rounded' ? 2.5 : shape === 'square' ? 0 : size / 2;
  const ns = 'http://www.w3.org/2000/svg';
  const svg = document.createElementNS(ns, 'svg');
  svg.setAttribute('viewBox', `0 0 ${totalW} ${totalH}`);
  svg.setAttribute('width', '100%');
  svg.style.cssText = 'display:block;overflow:visible';
  svg.setAttribute('role', 'img');
  svg.setAttribute('aria-label', 'GitHub contribution calendar');
  if (showLabels) {
    monthLabels.forEach(({ w, label }) => {
      const t = document.createElementNS(ns, 'text');
      t.setAttribute('x', padX + labelW + w * cellW);
      t.setAttribute('y', padY + 11);
      t.setAttribute('style', 'fill:var(--text-dim);opacity:.85');
      t.setAttribute('font-size', '9.5');
      t.setAttribute('font-family', "ui-monospace,'JetBrains Mono',monospace");
      t.setAttribute('letter-spacing', '0.04em');
      t.textContent = label;
      svg.appendChild(t);
    });
    DOW.forEach((d, i) => {
      const t = document.createElementNS(ns, 'text');
      t.setAttribute('x', padX);
      t.setAttribute('y', padY + labelH + (i * 2 + 1) * cellW + 4);
      t.setAttribute('style', 'fill:var(--text-dimmer)');
      t.setAttribute('font-size', '9');
      t.setAttribute('font-family', "ui-monospace,'JetBrains Mono',monospace");
      t.textContent = d;
      svg.appendChild(t);
    });
  }
  const g = document.createElementNS(ns, 'g');
  g.setAttribute('transform', `translate(${padX + labelW},${padY + labelH})`);
  weeks.forEach((week, w) => {
    week.forEach((cell, d) => {
      const lvl = Math.min(4, cell.level);
      const fill = palette[lvl] || palette[0];
      const x = w * cellW, y = d * cellW;
      const count = cell.count ?? TOTALS_PER_LEVEL[lvl];
      const iso = toIsoDate(cell.date);
      let node;
      if (shape === 'dot') {
        node = document.createElementNS(ns, 'circle');
        node.setAttribute('cx', x + size / 2);
        node.setAttribute('cy', y + size / 2);
        node.setAttribute('r', lvl === 0 ? 1.4 : 1.4 + lvl * 1.0);
        node.setAttribute('fill', fill);
      } else if (shape === 'hex') {
        const s = size / 2, cx = x + s, cy = y + s;
        const pts = [];
        for (let i = 0; i < 6; i++) {
          const a = (Math.PI / 3) * i + Math.PI / 6;
          pts.push(`${(cx + s * Math.cos(a)).toFixed(2)},${(cy + s * Math.sin(a)).toFixed(2)}`);
        }
        node = document.createElementNS(ns, 'polygon');
        node.setAttribute('points', pts.join(' '));
        node.setAttribute('fill', fill);
      } else {
        node = document.createElementNS(ns, 'rect');
        node.setAttribute('x', x); node.setAttribute('y', y);
        node.setAttribute('width', size); node.setAttribute('height', size);
        node.setAttribute('rx', radius); node.setAttribute('ry', radius);
        node.setAttribute('fill', fill);
      }
      node.setAttribute('data-date', iso);
      node.setAttribute('data-count', String(count));
      g.appendChild(node);
    });
  });
  svg.appendChild(g);
  return svg;
}

// ─── Shape preview SVG strings ────────────────────────────────────────────
function shapePreviewSVG(kind) {
  const fill = '#39D353';
  if (kind === 'dot') return `<svg viewBox="0 0 20 20" width="20" height="20"><circle cx="10" cy="10" r="3.2" fill="${fill}"/></svg>`;
  if (kind === 'circle') return `<svg viewBox="0 0 20 20" width="20" height="20"><circle cx="10" cy="10" r="6.5" fill="${fill}"/></svg>`;
  if (kind === 'hex') {
    const s = 7, pts = [];
    for (let i = 0; i < 6; i++) {
      const a = (Math.PI / 3) * i + Math.PI / 6;
      pts.push(`${(10 + s * Math.cos(a)).toFixed(2)},${(10 + s * Math.sin(a)).toFixed(2)}`);
    }
    return `<svg viewBox="0 0 20 20" width="20" height="20"><polygon points="${pts.join(' ')}" fill="${fill}"/></svg>`;
  }
  const r = kind === 'rounded' ? 2.5 : 0;
  return `<svg viewBox="0 0 20 20" width="20" height="20"><rect x="3" y="3" width="14" height="14" rx="${r}" fill="${fill}"/></svg>`;
}

const ICON_ARROW = `<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

// ─── Code preview token arrays ────────────────────────────────────────────
const SVG_LINES = [
  [['c-comment','<!-- 53 × 7 grid · cell=10 · gap=2 -->']],
  [['c-tag','<svg '],['c-attr','viewBox'],['','='],['c-str','"0 0 636 84"'],['',' '],['c-attr','xmlns'],['','='],['c-str','"http://www.w3.org/2000/svg"'],['c-tag','>']],
  [['',' '],['c-tag','<rect '],['c-attr','x'],['','='],['c-str','"0"'],['',' '],['c-attr','y'],['','='],['c-str','"0"'],['',' '],['c-attr','width'],['','='],['c-str','"10"'],['',' '],['c-attr','height'],['','='],['c-str','"10"'],['',' '],['c-attr','rx'],['','='],['c-str','"2"'],['',' '],['c-attr','fill'],['','='],['c-str','"#0E4429"'],['c-tag','/>']],
  [['',' '],['c-tag','<rect '],['c-attr','x'],['','='],['c-str','"12"'],['',' '],['c-attr','y'],['','='],['c-str','"0"'],['',' '],['c-attr','width'],['','='],['c-str','"10"'],['',' '],['c-attr','height'],['','='],['c-str','"10"'],['',' '],['c-attr','rx'],['','='],['c-str','"2"'],['',' '],['c-attr','fill'],['','='],['c-str','"#26A641"'],['c-tag','/>']],
  [['',' '],['c-tag','<rect '],['c-attr','x'],['','='],['c-str','"24"'],['',' '],['c-attr','y'],['','='],['c-str','"0"'],['',' '],['c-attr','width'],['','='],['c-str','"10"'],['',' '],['c-attr','height'],['','='],['c-str','"10"'],['',' '],['c-attr','rx'],['','='],['c-str','"2"'],['',' '],['c-attr','fill'],['','='],['c-str','"#39D353"'],['c-tag','/>']],
  [['',' '],['c-comment','<!-- … 368 more rects … -->']],
  [['c-tag','</svg>']],
];
const MD_LINES = [
  [['c-comment','<!-- paste into your README -->']],
  [[]],
  [['c-tag','!['],['c-str','contributions'],['c-tag',']('],['c-attr','https://contribkit.app/user/torvalds.svg'],['c-tag',')']],
  [[]],
  [['c-comment','<!-- or with options -->']],
  [[]],
  [['c-tag','!['],['c-str','contributions'],['c-tag',']('],['c-attr','https://contribkit.app/user/torvalds.svg']],
  [['',' '],['c-attr','?palette'],['','='],['c-str','monokai'],['c-tag','&']],
  [['',' '],['c-attr','&shape'],['','='],['c-str','hex'],['c-tag','&']],
  [['',' '],['c-attr','&bg'],['','='],['c-str','transparent'],['c-tag',')']],
];
function buildCodeBlock(lines) {
  const pre = document.createElement('pre');
  pre.className = 'code';
  lines.forEach((line) => {
    const div = document.createElement('div');
    div.className = 'code-line';
    if (!line.length) { div.innerHTML = '&nbsp;'; }
    else {
      line.forEach(([cls, txt]) => {
        const span = document.createElement('span');
        if (cls) span.className = cls;
        span.textContent = txt;
        div.appendChild(span);
      });
    }
    pre.appendChild(div);
  });
  return pre;
}

// ─── State ─────────────────────────────────────────────────────────────────
let customPalette = 'github';
let customShape = 'rounded';
let exportTab = 'png';
let liveCells = CELLS;
let liveUsername = window.__INITIAL_USERNAME__ ?? 'torvalds';

// ─── Customize ─────────────────────────────────────────────────────────────
function renderPaletteList() {
  const container = document.getElementById('palette-list');
  if (!container) return;
  container.innerHTML = '';
  PALETTE_LIST.forEach(({ key, name, swatches }) => {
    const btn = document.createElement('button');
    btn.className = `palette-row${customPalette === key ? ' active' : ''}`;
    btn.setAttribute('role', 'radio');
    btn.setAttribute('aria-checked', customPalette === key ? 'true' : 'false');
    const sw = document.createElement('span');
    sw.className = 'palette-swatches';
    swatches.forEach((c) => {
      const s = document.createElement('span');
      s.style.background = c;
      sw.appendChild(s);
    });
    const nm = document.createElement('span');
    nm.className = 'palette-name mono';
    nm.textContent = name;
    const ck = document.createElement('span');
    ck.className = 'palette-check';
    if (customPalette === key) ck.innerHTML = ICON_ARROW;
    btn.appendChild(sw);
    btn.appendChild(nm);
    btn.appendChild(ck);
    btn.addEventListener('click', () => { customPalette = key; renderCustomize(); });
    container.appendChild(btn);
  });
}
function renderShapeList() {
  const container = document.getElementById('shape-list');
  if (!container) return;
  container.innerHTML = '';
  SHAPES.forEach((s) => {
    const btn = document.createElement('button');
    btn.className = `shape-btn${customShape === s ? ' active' : ''}`;
    btn.setAttribute('role', 'radio');
    btn.setAttribute('aria-checked', customShape === s ? 'true' : 'false');
    btn.innerHTML = shapePreviewSVG(s) + `<span class="mono">${s}</span>`;
    btn.addEventListener('click', () => { customShape = s; renderCustomize(); });
    container.appendChild(btn);
  });
}
function renderCustomize() {
  const container = document.getElementById('custom-grid-container');
  if (container) {
    container.innerHTML = '';
    container.appendChild(renderCalendarSVG(liveCells, PALETTES[customPalette], customShape, 12, 3, false));
  }
  const hero = document.getElementById('hero-grid-container');
  if (hero) {
    hero.innerHTML = '';
    hero.appendChild(renderCalendarSVG(liveCells, PALETTES[customPalette], customShape, 13, 3, true));
  }
  const pal = PALETTES[customPalette];
  document.querySelectorAll('.legend .legend-sq').forEach((sq, i) => {
    sq.style.background = pal[i] ?? pal[0];
  });
  const pl = document.getElementById('custom-palette-label');
  if (pl) pl.textContent = customPalette;
  const sl = document.getElementById('custom-shape-label');
  if (sl) sl.textContent = customShape;
  renderPaletteList();
  renderShapeList();
  renderExportPreview();
}

// ─── Export ────────────────────────────────────────────────────────────────
const EXPORT_FORMATS = [
  { key:'png', label:'PNG', detail:'2880×720 · transparent', size:'186 KB' },
  { key:'svg', label:'SVG', detail:'Vector · 53×7 grid',     size:'24 KB' },
  { key:'md',  label:'MD',  detail:'GitHub-flavored embed',   size:'410 B' },
];
function renderExportTabs() {
  const tabs = document.getElementById('export-tabs');
  if (!tabs) return;
  tabs.innerHTML = '';
  EXPORT_FORMATS.forEach(({ key, label, detail, size }) => {
    const btn = document.createElement('button');
    btn.className = `export-tab${exportTab === key ? ' active' : ''}`;
    btn.setAttribute('role', 'tab');
    btn.setAttribute('aria-selected', exportTab === key ? 'true' : 'false');
    btn.innerHTML = `<span class="mono tab-key">.${key}</span><span class="tab-label">${label}</span><span class="tab-detail">${detail}</span><span class="mono dimmer tab-size">${size}</span>`;
    btn.addEventListener('click', () => { exportTab = key; renderExportTabs(); renderExportPreview(); });
    tabs.appendChild(btn);
  });
}
function renderExportPreview() {
  const preview = document.getElementById('export-preview');
  if (!preview) return;
  preview.innerHTML = '';
  const card = document.createElement('div');
  card.className = 'preview-card';
  if (exportTab === 'png') {
    card.classList.add('png-preview');
    const checker = document.createElement('div');
    checker.className = 'preview-checker';
    checker.setAttribute('aria-hidden', 'true');
    card.appendChild(checker);
    const content = document.createElement('div');
    content.className = 'preview-content';
    content.appendChild(renderCalendarSVG(liveCells, PALETTES[customPalette], customShape, 10, 2, false));
    card.appendChild(content);
    const tag = document.createElement('div');
    tag.className = 'preview-tag mono';
    tag.textContent = `${liveUsername}.png`;
    card.appendChild(tag);
  } else {
    card.classList.add('code-preview');
    const lines = exportTab === 'svg' ? SVG_LINES : MD_LINES;
    card.appendChild(buildCodeBlock(lines));

    let plainText;
    if (exportTab === 'svg') {
      const svgEl = renderCalendarSVG(liveCells, PALETTES[customPalette], customShape, 10, 2, false);
      plainText = new XMLSerializer().serializeToString(svgEl);
    } else {
      plainText = `![contributions](https://contribkit.app/user/${liveUsername}.svg)`;
    }

    const copyBtn = document.createElement('button');
    copyBtn.className = 'copy-btn mono';
    copyBtn.textContent = 'copy';
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(plainText).then(() => {
        copyBtn.textContent = 'copied!';
        setTimeout(() => { copyBtn.textContent = 'copy'; }, 1500);
      });
    });
    card.appendChild(copyBtn);

    const tag = document.createElement('div');
    tag.className = 'preview-tag mono';
    tag.textContent = exportTab === 'svg' ? `${liveUsername}.svg` : 'README.md';
    card.appendChild(tag);
  }
  preview.appendChild(card);
}

// ─── Username strip + render ───────────────────────────────────────────────
function summarizeCells(cells) {
  const sorted = [...cells].sort((a, b) => (a.date < b.date ? -1 : 1));
  let count = 0, streak = 0, longest = 0, cur = 0;
  sorted.forEach((c) => {
    count += TOTALS_PER_LEVEL[c.level] || 0;
    if (c.level > 0) { cur++; if (cur > longest) longest = cur; } else cur = 0;
  });
  for (let i = sorted.length - 1; i >= 0; i--) {
    if (sorted[i].level > 0) streak++; else break;
  }
  return { count, streak, longest };
}

function updateYearRange(cells) {
  const el = document.getElementById('hero-year-range');
  if (!el || !cells.length) return;
  const first = cells[0].date.getFullYear();
  const last = cells[cells.length - 1].date.getFullYear();
  el.textContent = first === last ? String(first) : `${first} – ${last}`;
}

function updateHeroStats(summary) {
  const bar = document.querySelector('.bar-tag');
  if (bar) bar.innerHTML = `<span class="mono" style="color:var(--g-4)">${summary.count.toLocaleString()}</span> contributions`;
  const stats = document.querySelector('.legend-stats');
  if (stats) stats.innerHTML = `<span><b class="mono">${summary.streak}</b> day streak</span><span class="sep">·</span><span><b class="mono">${summary.longest}</b> longest</span>`;
}

const ERRORS = {
  404: "user not found — check the username and try again",
  400: "invalid username",
  502: "could not reach github, try again in a moment",
};

function setHeroError(msg) {
  const el = document.getElementById('hero-error');
  if (!el) return;
  if (msg) { el.textContent = `↳ ${msg}`; el.hidden = false; }
  else { el.textContent = ''; el.hidden = true; }
}

function buildGrid(apiCells) {
  const map = new Map();
  for (const c of apiCells) map.set(c.date, { level: c.level, count: c.count ?? null });
  const year = parseInt(apiCells[0]?.date ?? String(new Date().getFullYear()), 10);
  const jan1 = new Date(year, 0, 1, 12, 0, 0);
  const start = new Date(jan1);
  start.setDate(jan1.getDate() - jan1.getDay());
  const cells = [];
  for (let i = 0; i < 53 * 7; i++) {
    const d = new Date(start);
    d.setDate(start.getDate() + i);
    const iso = toIsoDate(d);
    const entry = map.get(iso);
    cells.push({ date: d, level: entry?.level ?? 0, count: entry?.count ?? null });
  }
  return cells;
}

async function renderFromGitHub(username) {
  const btn = document.getElementById('hero-render-btn');
  const container = document.getElementById('hero-grid-container');
  const display = document.getElementById('hero-username-display');
  const yearEl = document.getElementById('hero-year');
  if (!btn || !container) return;

  const yearVal = Number(yearEl?.value ?? 0);
  const yearQuery = yearVal && yearVal <= new Date().getFullYear() ? `&year=${yearVal}` : '';

  setHeroError(null);
  btn.disabled = true;
  btn.textContent = 'loading…';

  try {
    const res = await fetch(`/api/contributions?user=${encodeURIComponent(username)}${yearQuery}`);
    const data = await res.json();

    if (!res.ok) {
      setHeroError(ERRORS[res.status] ?? data.error ?? 'something went wrong');
    } else {
      const cells = buildGrid(data.cells);
      liveCells = cells;
      liveUsername = username;
      renderCustomize();
      if (display) display.textContent = username;
      const stats = summarizeCells(data.cells);
      if (data.total != null) stats.count = data.total;
      updateHeroStats(stats);
      const dataCells = data.cells.map((c) => ({ date: new Date(c.date + 'T12:00:00'), level: c.level }));
      updateYearRange(dataCells);
      renderExportPreview();
      const howWidget = document.getElementById('how-widget-username');
      if (howWidget) howWidget.textContent = username;
    }
  } catch {
    setHeroError('could not reach the server, try again');
  }

  btn.disabled = false;
  btn.innerHTML = `render ${ICON_ARROW}`;
}

function initUsernameStrip() {
  const input = document.getElementById('hero-username');
  const btn = document.getElementById('hero-render-btn');
  const display = document.getElementById('hero-username-display');
  if (!input || !btn || !display) return;

  input.addEventListener('input', () => {
    display.textContent = input.value.trim() || 'torvalds';
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') renderFromGitHub(input.value.trim() || 'torvalds');
  });
  btn.addEventListener('click', () => {
    renderFromGitHub(input.value.trim() || 'torvalds');
  });
  document.querySelectorAll('.sug-btn').forEach((el) => {
    el.addEventListener('click', () => {
      const u = el.dataset.username;
      if (!u) return;
      input.value = u;
      display.textContent = u;
      renderFromGitHub(u);
    });
  });
}

// ─── Cell tooltip (native popover) ─────────────────────────────────────────
function initCellTooltip() {
  const tip = document.getElementById('cell-tip');
  if (!tip || typeof tip.showPopover !== 'function') return;

  let activeEl = null;

  function position() {
    if (!activeEl) return;
    const r = activeEl.getBoundingClientRect();
    const tr = tip.getBoundingClientRect();
    let left = r.left + r.width / 2 - tr.width / 2;
    let top = r.top - tr.height - 8;
    left = Math.max(8, Math.min(left, window.innerWidth - tr.width - 8));
    if (top < 8) top = r.bottom + 8;
    tip.style.left = `${left}px`;
    tip.style.top = `${top}px`;
  }

  function show(el) {
    activeEl = el;
    tip.textContent = formatContribLabel(
      el.getAttribute('data-date') || '',
      parseInt(el.getAttribute('data-count') || '0', 10),
    );
    if (!tip.matches(':popover-open')) tip.showPopover();
    position();
  }

  function hide() {
    activeEl = null;
    if (tip.matches(':popover-open')) tip.hidePopover();
  }

  document.addEventListener('mouseover', (e) => {
    const t = e.target;
    if (!(t instanceof Element)) return;
    const cell = t.closest('[data-date][data-count]');
    if (cell) show(cell);
    else if (activeEl) hide();
  });

  document.addEventListener('mouseleave', hide);
  window.addEventListener('scroll', position, { passive: true });
  window.addEventListener('resize', position);
}

// ─── Init ──────────────────────────────────────────────────────────────────
// Module scripts are deferred — DOM is parsed by the time we run.
renderCustomize();
renderExportTabs();
renderExportPreview();
initUsernameStrip();
updateYearRange(CELLS);
initCellTooltip();
</script>
