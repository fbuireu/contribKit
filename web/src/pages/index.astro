---
import '../ui/styles/global.css';
import '../ui/styles/components/cell-tip.css';
import TopNav from '../ui/components/TopNav.astro';
import Hero from '../ui/components/Hero.astro';
import HowItWorks from '../ui/components/HowItWorks.astro';
import Customize from '../ui/components/Customize.astro';
import Export from '../ui/components/Export.astro';
import Widget from '../ui/components/Widget.astro';
import Footer from '../ui/components/Footer.astro';
import { fetchContributions } from '../application/use-cases/fetch-contributions';
import type { ContributionDay } from '../domain/entities/contribution-day';
import { parseUsername } from '../domain/value-objects/username';
import { parseYear, isYear } from '../domain/value-objects/year';
import { createGithubHtmlContributionsRepository } from '../infrastructure/github/github-html-contributions-repository';
import { TOTALS_PER_LEVEL, toIsoDate } from '../ui/lib/contribution';
import { mulberry32 } from '../ui/lib/mulberry';

const DEFAULT_USERNAME = 'torvalds';

const isFailure = (value: unknown): value is { kind: string } =>
  typeof value === 'object' && value !== null && 'kind' in value;

// ─── Deterministic contribution data (seed=7, anchored 2026-05-17) ───────────

interface Cell { date: Date; level: number; count?: number | null; }

function buildGridFromApi(days: readonly ContributionDay[], year: number): Cell[] {
  const map = new Map<string, { level: number; count: number | null }>();
  for (const d of days) map.set(d.date, { level: d.level, count: d.count });
  const jan1 = new Date(year, 0, 1, 12, 0, 0);
  const start = new Date(jan1);
  start.setDate(jan1.getDate() - jan1.getDay());
  const cells: Cell[] = [];
  for (let i = 0; i < 53 * 7; i++) {
    const d = new Date(start);
    d.setDate(start.getDate() + i);
    const iso = toIsoDate(d);
    const entry = map.get(iso);
    cells.push({ date: d, level: entry?.level ?? 0, count: entry?.count ?? null });
  }
  return cells;
}

async function loadInitialContributions(): Promise<{ cells: Cell[]; total: number | null; year: number } | null> {
  const username = parseUsername(DEFAULT_USERNAME);
  if (isFailure(username)) return null;
  const currentYear = new Date().getFullYear();
  const year = parseYear(String(currentYear));
  if (isFailure(year)) return null;
  const yearValue = isYear(year) ? year : null;

  const repo = createGithubHtmlContributionsRepository();
  const result = await fetchContributions(repo)(username, yearValue);
  if (isFailure(result)) return null;
  return {
    cells: buildGridFromApi(result.days, currentYear),
    total: result.total,
    year: currentYear,
  };
}

function generateData(seed = 7): Cell[] {
  const rand = mulberry32(seed);
  const cells: Cell[] = [];
  const today = new Date(2026, 4, 17);
  const end = new Date(today);
  end.setDate(end.getDate() + (6 - end.getDay()));
  const totalDays = 53 * 7;
  const start = new Date(end);
  start.setDate(start.getDate() - (totalDays - 1));

  for (let i = 0; i < totalDays; i++) {
    const d = new Date(start);
    d.setDate(start.getDate() + i);
    const dow = d.getDay();
    const progress = i / totalDays;
    let base = 0.35 + progress * 0.5;
    if (dow === 0 || dow === 6) base *= 0.55;
    const cluster = Math.sin(i / 9) * 0.25 + Math.sin(i / 23) * 0.2;
    const r = rand();
    let score = base + cluster + (r - 0.5) * 0.6;
    if (rand() < 0.08) score -= 0.6;
    let level = 0;
    if (score >= 0.2) level = 1;
    if (score >= 0.45) level = 2;
    if (score >= 0.7) level = 3;
    if (score >= 0.95) level = 4;
    cells.push({ date: d, level });
  }
  return cells;
}

function summarize(cells: Cell[]) {
  let count = 0, streak = 0, longest = 0, cur = 0;
  cells.forEach((c) => {
    count += c.count ?? TOTALS_PER_LEVEL[c.level] ?? 0;
    if (c.level > 0) { cur++; if (cur > longest) longest = cur; } else cur = 0;
  });
  for (let i = cells.length - 1; i >= 0; i--) {
    if (cells[i].level > 0) streak++; else break;
  }
  return { count, streak, longest };
}

function renderSVG(
  cells: Cell[],
  palette: string[],
  shape: string,
  size: number,
  gap: number,
  showLabels: boolean,
): string {
  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const DOW = ['Mon','Wed','Fri'];
  const weeks: Cell[][] = [];
  for (let w = 0; w < 53; w++) weeks.push(cells.slice(w * 7, w * 7 + 7));

  const monthLabels: { w: number; label: string }[] = [];
  let lastMonth = -1;
  weeks.forEach((week, w) => {
    if (!week[0]) return;
    const m = week[0].date.getMonth();
    if (m !== lastMonth && week[0].date.getDate() <= 7) {
      monthLabels.push({ w, label: MONTHS[m] });
      lastMonth = m;
    }
  });

  const cellW = size + gap;
  const labelW = showLabels ? 28 : 0;
  const labelH = showLabels ? 18 : 0;
  const padX = 12, padY = 12;
  const totalW = 53 * cellW + labelW + padX * 2;
  const totalH = 7 * cellW + labelH + padY * 2;
  const radius = shape === 'rounded' ? 2.5 : shape === 'square' ? 0 : size / 2;

  const p: string[] = [];
  p.push(`<svg viewBox="0 0 ${totalW} ${totalH}" width="100%" style="display:block;overflow:visible" role="img" aria-label="GitHub contribution calendar">`);
  if (showLabels) {
    monthLabels.forEach(({ w, label }) => {
      p.push(`<text x="${padX + labelW + w * cellW}" y="${padY + 11}" style="fill:var(--text-dim);opacity:.85" font-size="9.5" font-family="ui-monospace,'JetBrains Mono',monospace" letter-spacing="0.04em">${label}</text>`);
    });
    DOW.forEach((d, i) => {
      p.push(`<text x="${padX}" y="${padY + labelH + (i * 2 + 1) * cellW + 4}" style="fill:var(--text-dimmer)" font-size="9" font-family="ui-monospace,'JetBrains Mono',monospace">${d}</text>`);
    });
  }
  p.push(`<g transform="translate(${padX + labelW},${padY + labelH})">`);
  weeks.forEach((week, w) => {
    week.forEach((cell, d) => {
      const lvl = Math.min(4, cell.level);
      const fill = palette[lvl] || palette[0];
      const x = w * cellW, y = d * cellW;
      const count = cell.count ?? TOTALS_PER_LEVEL[lvl];
      const data = ` data-date="${toIsoDate(cell.date)}" data-count="${count}"`;
      if (shape === 'dot') {
        const r = lvl === 0 ? 1.4 : 1.4 + lvl * 1.0;
        p.push(`<circle cx="${x + size / 2}" cy="${y + size / 2}" r="${r}" fill="${fill}"${data}/>`);
      } else if (shape === 'hex') {
        const s = size / 2, cx = x + s, cy = y + s;
        const pts: string[] = [];
        for (let i = 0; i < 6; i++) {
          const a = (Math.PI / 3) * i + Math.PI / 6;
          pts.push(`${(cx + s * Math.cos(a)).toFixed(2)},${(cy + s * Math.sin(a)).toFixed(2)}`);
        }
        p.push(`<polygon points="${pts.join(' ')}" fill="${fill}"${data}/>`);
      } else {
        p.push(`<rect x="${x}" y="${y}" width="${size}" height="${size}" rx="${radius}" fill="${fill}"${data}/>`);
      }
    });
  });
  p.push('</g></svg>');
  return p.join('');
}

const CLASSIC = ['#161B22','#0E4429','#006D32','#26A641','#39D353'];

const initial = await loadInitialContributions();
const cells: Cell[] = initial?.cells ?? generateData(7);
const summary = summarize(cells);
if (initial?.total != null) summary.count = initial.total;

const heroSVG = renderSVG(cells, CLASSIC, 'rounded', 13, 3, true);
const exportPNGSVG = renderSVG(cells, CLASSIC, 'rounded', 10, 2, false);

const initialCellsForClient = cells.map((c) => ({
  date: toIsoDate(c.date),
  level: c.level,
  count: c.count ?? null,
}));

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=3600, stale-while-revalidate=86400',
);

const TITLE = 'ContribKit — Your GitHub activity, your aesthetic.';
const DESCRIPTION = 'Visualize, customize, and export your GitHub contribution calendar — no token required.';
---

<!doctype html>
