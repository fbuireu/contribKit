---
import BaseLayout from '../ui/components/layouts/BaseLayout.astro';

const TITLE = 'Terms of Use — ContribKit';
const d = new Date(); d.setDate(d.getDate() - 7);
const effectiveDate = d.toISOString().slice(0, 10);
---

<BaseLayout title={TITLE} robots="noindex, nofollow">
  <main class="legal-page">
    <div class="wrap">
      <div class="legal-header">
        <a href="/" class="back-link mono">← back</a>
        <h1>Terms of Use</h1>
        <p class="dimmer mono">Effective date: {effectiveDate}</p>
      </div>
      <div class="legal-body">

        <h2>Acceptance</h2>
        <p>By downloading or using ContribKit, you agree to these terms. If you do not agree, do not use the app.</p>

        <h2>What ContribKit does</h2>
        <p>ContribKit fetches and visualizes publicly available GitHub contribution data. It is a personal productivity tool — not a GitHub product and not affiliated with GitHub, Inc.</p>

        <h2>Acceptable use</h2>
        <p>You may use ContribKit to visualize and export your own public GitHub contributions or those of any public GitHub profile. You may not use the app to scrape data at scale, harass individuals, or violate GitHub's Terms of Service.</p>

        <h2>Exports and content</h2>
        <p>Exported images and SVGs generated by ContribKit are yours to use. Contribution data displayed in the app is sourced from GitHub and subject to GitHub's terms.</p>

        <h2>In-app purchases</h2>
        <p>Tips are voluntary, one-time, non-refundable purchases that support the developer. They do not unlock features — ContribKit is fully functional without purchasing anything.</p>

        <h2>Disclaimer</h2>
        <p>ContribKit is provided "as is" without warranties of any kind. We are not liable for any damages arising from use of the app or reliance on data it displays.</p>

        <h2>Changes</h2>
        <p>We may update these terms at any time. Continued use of the app constitutes acceptance of any changes.</p>

        <h2>Contact</h2>
        <p>Questions? <a href="mailto:fbuireu@gmail.com">fbuireu@gmail.com</a></p>

      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .legal-page { padding: 64px 0 96px; }
  .legal-header { margin-bottom: 48px; border-bottom: 1px solid var(--border); padding-bottom: 32px; }
  .back-link { font-size: 13px; color: var(--text-dim); display: inline-block; margin-bottom: 20px; transition: color 100ms; }
  .back-link:hover { color: var(--text); }
  h1 { font-size: clamp(28px, 4vw, 40px); font-weight: 700; letter-spacing: -0.03em; margin: 0 0 8px; }
  .legal-body { max-width: 640px; }
  .legal-body h2 { font-size: 15px; font-weight: 600; margin: 36px 0 8px; color: var(--text); }
  .legal-body p { font-size: 14px; color: var(--text-dim); line-height: 1.7; margin: 0; }
  .legal-body a { color: var(--contrib-peak); text-decoration: underline; text-underline-offset: 3px; }
</style>
