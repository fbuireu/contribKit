---
import BaseLayout from "../ui/components/layouts/BaseLayout.astro";

const TITLE = "Terms of Use — ContribKit";
const d = new Date();
d.setDate(d.getDate() - 7);
const EFFECTIVE_DATE = d.toISOString().slice(0, 10);
---

<BaseLayout title={TITLE} robots="noindex, nofollow">
  <div class="legal-page">
    <div class="wrap">
      <div class="legal-header">
        <a href="/" class="back-link mono">← back</a>
        <h1>Terms of Use</h1>
        <p class="dimmer mono">Effective date: {EFFECTIVE_DATE}</p>
      </div>
      <div class="legal-body">

        <h2>Acceptance</h2>
        <p>By downloading or using ContribKit, or by accessing this website, you agree to these terms. If you do not agree, do not use the app or site.</p>

        <h2>What ContribKit is</h2>
        <p>ContribKit is a personal productivity tool that fetches and visualises publicly available GitHub contribution data. It is not a GitHub product and is not affiliated with GitHub, Inc.</p>

        <h2>Acceptable use</h2>
        <p>You may use ContribKit to visualise and export public GitHub contributions — your own or any public profile's. You may not use it to scrape data at scale, harass individuals, or violate <a href="https://docs.github.com/en/site-policy/github-terms/github-terms-of-service" target="_blank" rel="noopener">GitHub's Terms of Service</a>.</p>

        <h2>Exports and content</h2>
        <p>Exported images and SVGs generated by ContribKit are yours to use freely. Contribution data displayed in the app is sourced from GitHub and remains subject to GitHub's terms.</p>

        <h2>Analytics and cookies (website)</h2>
        <p>This website uses Google Analytics and Better Stack to understand traffic and site performance. These services are loaded only with your consent, which you can manage at any time via the <button type="button" data-cc="show-preferencesModal" class="inline-prefs-btn">cookie preferences</button> panel. See the <a href="/privacy">Privacy Policy</a> for full details on the data collected.</p>

        <h2>In-app purchases</h2>
        <p>Tips are voluntary, one-time, non-refundable purchases that support the developer. They do not unlock features — ContribKit is fully functional without purchasing anything. Purchases are processed by Apple (App Store) or Google (Play Store).</p>

        <h2>Disclaimer</h2>
        <p>ContribKit is provided "as is" without warranties of any kind. We are not liable for any damages arising from use of the app or reliance on data it displays.</p>

        <h2>Changes</h2>
        <p>We may update these terms at any time. The effective date above reflects the most recent revision. Continued use of the app or site after an update constitutes acceptance of the revised terms.</p>

        <h2>Contact</h2>
        <p>Questions? <a href="mailto:contact@contribkit.app">contact@contribkit.app</a></p>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .legal-page { padding: 64px 0 96px; }
  .legal-header { margin-bottom: 48px; border-bottom: 1px solid var(--border); padding-bottom: 32px; }
  .back-link { font-size: 13px; color: var(--text-dim); display: inline-block; margin-bottom: 20px; transition: color 100ms; }
  .back-link:hover { color: var(--text); }
  h1 { font-size: clamp(28px, 4vw, 40px); font-weight: 700; letter-spacing: -0.03em; margin: 0 0 8px; }
  .legal-body { max-width: 640px; }
  .legal-body h2 { font-size: 15px; font-weight: 600; margin: 36px 0 8px; color: var(--text); }
  .legal-body p { font-size: 14px; color: var(--text-dim); line-height: 1.7; margin: 0 0 8px; }
  .legal-body a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .inline-prefs-btn {
    font: inherit;
    font-size: 14px;
    color: var(--accent);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
