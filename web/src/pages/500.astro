---
import { getLogger } from "@infrastructure/logging/better-stack-logger";
import BaseLayout from "@ui/components/core/layouts/BaseLayout.astro";
import type { Metadata } from "@ui/components/core/seo/types";
import ErrorView from "@ui/components/error/ErrorView.astro";
import { type TerminalLine, TerminalLineKind } from "@ui/components/error/types";
import { logServerError } from "@ui/utils/log-server-error";

const path = Astro.url.pathname || "/";

const metadata: Metadata = {
	title: "500 — something broke · ContribKit",
	description: "Something went wrong on our end.",
	robots: "noindex, nofollow",
};

const error = (Astro.props as { error?: unknown }).error;
const executionContext = (Astro.locals as { cfContext?: ExecutionContext }).cfContext;
logServerError({ logger: getLogger(executionContext), error, path });

const terminal: TerminalLine[] = [
	{ kind: TerminalLineKind.Command, text: `contribkit render ${path}` },
	{ kind: TerminalLineKind.Error, text: "error: 500 — render pipeline crashed (E_RENDER)" },
	{ kind: TerminalLineKind.Output, text: "trace: 8f3c1a · reported automatically" },
];

Astro.response.status = 500;
---

<BaseLayout metadata={metadata}>
  <ErrorView
    code={500}
    tone="danger"
    eyebrow={`GET ${path} → 500`}
    title="Something broke on our end."
    message="The renderer hit an exception. It’s not you — your calendar is fine. We’ve logged it and we’re already looking."
    terminal={terminal}
    primary={{ href: "/", label: "Try again", icon: "reload" }}
  />
</BaseLayout>
