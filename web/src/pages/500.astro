---
import { NOT_CACHEABLE } from "@application/http/cache-control";
import { logServerError } from "@application/http/failure-log";
import { logger } from "@infrastructure/logging/logger";
import BaseLayout from "@ui/components/core/layouts/BaseLayout.astro";
import { type Metadata, RobotsDirective } from "@ui/components/core/seo/types";
import ErrorView from "@ui/components/error/ErrorView.astro";
import { ErrorActionIcon, type TerminalLine, TerminalLineKind, Tone } from "@ui/components/error/types";

const path = Astro.url.pathname || "/";

const metadata: Metadata = {
	title: "500: something broke · ContribKit",
	description: "Something went wrong on our end.",
	robots: RobotsDirective.NoIndexNoFollow,
};

const error = (Astro.props as { error?: unknown }).error;
logServerError({ logger, error, path });

const terminal: TerminalLine[] = [
	{ kind: TerminalLineKind.Command, text: `contribkit render ${path}` },
	{ kind: TerminalLineKind.Error, text: "error: 500, render pipeline crashed" },
	{ kind: TerminalLineKind.Output, text: "reported automatically" },
];

Astro.response.status = 500;
Astro.response.headers.set("Cache-Control", NOT_CACHEABLE);
---

<BaseLayout metadata={metadata}>
  <ErrorView
    code={500}
    tone={Tone.Danger}
    eyebrow={`GET ${path} → 500`}
    title="Something broke on our end."
    message="The renderer hit an exception. It’s not you: your calendar is fine. We’ve logged it and we’re already looking."
    terminal={terminal}
    primary={{ href: "/", label: "Try again", icon: ErrorActionIcon.Reload }}
  />
</BaseLayout>
