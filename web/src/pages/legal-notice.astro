---
import type { Metadata } from "@ui/components/core/metadata";
import BaseLayout from "@ui/components/layouts/BaseLayout.astro";
import "@ui/components/legal.css";
import { decrypt, type ShuffledData } from "@ui/lib/crypto";

const TITLE = "Legal Notice — ContribKit";
const EFFECTIVE_DATE = "2026-06-03";

const metadata: Metadata = { title: TITLE, robots: "noindex, nofollow" };

const OWNER_NAME: ShuffledData[] = [
	{ letter: "u", order: 12 },
	{ letter: "B", order: 7 },
	{ letter: "r", order: 3 },
	{ letter: "F", order: 0 },
	{ letter: "e", order: 11 },
	{ letter: " ", order: 6 },
	{ letter: "r", order: 2 },
	{ letter: "n", order: 5 },
	{ letter: "i", order: 9 },
	{ letter: "e", order: 1 },
	{ letter: "r", order: 10 },
	{ letter: "a", order: 4 },
	{ letter: "u", order: 8 },
];

const OWNER_NIF: ShuffledData[] = [
	{ letter: "9", order: 6 },
	{ letter: "H", order: 8 },
	{ letter: "7", order: 3 },
	{ letter: "2", order: 4 },
	{ letter: "4", order: 0 },
	{ letter: "6", order: 1 },
	{ letter: "9", order: 2 },
	{ letter: "7", order: 7 },
	{ letter: "2", order: 5 },
];

const OWNER_ADDRESS: ShuffledData[] = [
	{ letter: "C", order: 0 },
	{ letter: "d", order: 7 },
	{ letter: "t", order: 14 },
	{ letter: "5", order: 21 },
	{ letter: "2", order: 28 },
	{ letter: "c", order: 35 },
	{ letter: " ", order: 42 },
	{ letter: "a", order: 1 },
	{ letter: "e", order: 8 },
	{ letter: "o", order: 15 },
	{ letter: "B", order: 22 },
	{ letter: "9", order: 29 },
	{ letter: "e", order: 36 },
	{ letter: "S", order: 43 },
	{ letter: "r", order: 2 },
	{ letter: " ", order: 9 },
	{ letter: " ", order: 16 },
	{ letter: ",", order: 23 },
	{ letter: ",", order: 30 },
	{ letter: "l", order: 37 },
	{ letter: "p", order: 44 },
	{ letter: "r", order: 3 },
	{ letter: "L", order: 10 },
	{ letter: "3", order: 17 },
	{ letter: " ", order: 24 },
	{ letter: " ", order: 31 },
	{ letter: "o", order: 38 },
	{ letter: "a", order: 45 },
	{ letter: "e", order: 4 },
	{ letter: "o", order: 11 },
	{ letter: "6", order: 18 },
	{ letter: "0", order: 25 },
	{ letter: "B", order: 32 },
	{ letter: "n", order: 39 },
	{ letter: "i", order: 46 },
	{ letter: "r", order: 5 },
	{ letter: "r", order: 12 },
	{ letter: ",", order: 19 },
	{ letter: "8", order: 26 },
	{ letter: "a", order: 33 },
	{ letter: "a", order: 40 },
	{ letter: "n", order: 47 },
	{ letter: " ", order: 6 },
	{ letter: "e", order: 13 },
	{ letter: " ", order: 20 },
	{ letter: "0", order: 27 },
	{ letter: "r", order: 34 },
	{ letter: ",", order: 41 },
];
---

<BaseLayout metadata={metadata}>
  <div class="legal-page">
    <div class="wrap">
      <div class="legal-header">
        <a href="/" data-astro-prefetch="false" class="back-link mono link-action">← back</a>
        <h1>Legal Notice</h1>
        <p class="dimmer mono">Effective date: {EFFECTIVE_DATE}</p>
      </div>
      <div class="legal-body">

        <h2>Owner identification</h2>
        <p>In compliance with Article 10 of Spanish Law 34/2002 on Information Society Services and Electronic Commerce (LSSI-CE), the following identification details of the website owner are made available:</p>

        <table class="id-table">
          <caption class="sr-only">Owner identification details</caption>
          <tbody>
            <tr>
              <th scope="row">Owner</th>
              <td><span class="protected">{decrypt(OWNER_NAME)}</span></td>
            </tr>
            <tr>
              <th scope="row">Tax ID (NIF)</th>
              <td><span class="protected mono">{decrypt(OWNER_NIF)}</span></td>
            </tr>
            <tr>
              <th scope="row">Address</th>
              <td><span class="protected">{decrypt(OWNER_ADDRESS)}</span></td>
            </tr>
            <tr>
              <th scope="row">Contact</th>
              <td><a href="mailto:contact@contribkit.app">contact@contribkit.app</a></td>
            </tr>
          </tbody>
        </table>

        <h2>Scope</h2>
        <p>This legal notice governs the use of <code>contribkit.app</code> (the "Site") and the ContribKit mobile app available on the App Store and Google Play. Accessing the Site or using the app constitutes full acceptance of this notice.</p>

        <h2>Intellectual property</h2>
        <p>The source code, design, logos, and original content of the Site and app are the property of the owner and are protected under Spanish and international intellectual property law. Reproduction, distribution, or public communication without express authorisation is prohibited, except as permitted by law.</p>
        <p>Contribution data displayed by the app is sourced from public GitHub profiles and belongs to their respective owners. ContribKit is not a GitHub product and is not affiliated with GitHub, Inc.</p>

        <h2>Liability</h2>
        <p>The owner does not guarantee uninterrupted availability of the Site or app, nor the accuracy of the data displayed. Use of the Site and app is the sole responsibility of the user. The owner is not liable for any damages arising from use of or inability to use the service.</p>
        <p>The Site may contain links to external sites (GitHub, App Store, Google Play). The owner assumes no responsibility for their content or privacy practices.</p>

        <h2>Governing law and jurisdiction</h2>
        <p>This legal notice is governed by Spanish law. Any disputes arising from use of the Site or app shall be submitted to the competent courts in accordance with applicable legislation.</p>

        <h2>Privacy</h2>
        <p>Information on personal data processing is available in the <a href="/privacy">Privacy Policy</a>.</p>

        <h2>Cookies</h2>
        <p>Information on cookies is available in the <a href="/privacy">Privacy Policy</a>. You can manage your preferences at any time via the <button type="button" data-cc="show-preferencesModal" class="inline-prefs-btn">cookie preferences</button> panel.</p>

      </div>
    </div>
  </div>
</BaseLayout>

