---
import type { Metadata } from "@ui/components/core/metadata";
import ErrorView from "@ui/components/error/ErrorView.astro";
import { type TerminalLine, TerminalLineKind } from "@ui/components/error/terminal-line";
import BaseLayout from "@ui/components/layouts/BaseLayout.astro";

const path = Astro.url.pathname || "/";

const metadata: Metadata = {
	title: "404 — page not found · ContribKit",
	description: "The page you requested doesn't exist.",
	robots: "noindex, nofollow",
};

const terminal: TerminalLine[] = [
	{ kind: TerminalLineKind.Command, text: `contribkit open ${path}` },
	{ kind: TerminalLineKind.Error, text: "error: 404 — nothing committed at this path" },
	{ kind: TerminalLineKind.Output, text: "hint: this page ghosted us 👻" },
];

Astro.response.status = 404;
---

<BaseLayout metadata={metadata}>
  <ErrorView
    code={404}
    tone="accent"
    eyebrow={`GET ${path} → 404`}
    title="This page ghosted you."
    message="The page you’re after doesn’t exist — like a contribution square that never lit up. It may have moved, or it was never here at all."
    terminal={terminal}
    primary={{ href: "/", label: "Back to home", icon: "back" }}
  />
</BaseLayout>
