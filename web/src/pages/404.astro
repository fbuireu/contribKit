---
import { NOT_CACHEABLE } from "@application/http/cache-control";
import BaseLayout from "@ui/components/core/layouts/BaseLayout.astro";
import { type Metadata, RobotsDirective } from "@ui/components/core/seo/types";
import ErrorView from "@ui/components/error/ErrorView.astro";
import { ErrorActionIcon, type TerminalLine, TerminalLineKind, Tone } from "@ui/components/error/types";

const path = Astro.url.pathname || "/";

const metadata: Metadata = {
	title: "404: page not found · ContribKit",
	description: "The page you requested doesn't exist.",
	robots: RobotsDirective.NoIndexNoFollow,
};

const terminal: TerminalLine[] = [
	{ kind: TerminalLineKind.Command, text: `contribkit open ${path}` },
	{ kind: TerminalLineKind.Error, text: "error: 404, nothing committed at this path" },
	{ kind: TerminalLineKind.Output, text: "hint: this page ghosted us 👻" },
];

Astro.response.status = 404;
Astro.response.headers.set("Cache-Control", NOT_CACHEABLE);
---

<BaseLayout metadata={metadata}>
  <ErrorView
    code={404}
    tone={Tone.Accent}
    eyebrow={`GET ${path} → 404`}
    title="This page ghosted you."
    message="The page you’re after doesn’t exist, like a cell that never lit up. It may have moved, or it was never here at all."
    terminal={terminal}
    primary={{ href: "/", label: "Back to home", icon: ErrorActionIcon.Back }}
  />
</BaseLayout>
