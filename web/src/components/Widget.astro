---
// Mini contribution grid for the phone mockup
const pal = ['#161b22', '#0E4429', '#006D32', '#26A641', '#39D353'];

function mulberry32(s: number) {
  return () => {
    let t = (s += 0x6d2b79f5);
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(99);
const COLS = 26, ROWS = 7;
const cells: number[] = Array.from({ length: COLS * ROWS }, (_, i) => {
  const r = rand();
  const progress = (Math.floor(i / ROWS)) / COLS;
  const boosted = r + progress * 0.3 + Math.sin(i / 8) * 0.15;
  if (boosted > 0.92) return 4;
  if (boosted > 0.78) return 3;
  if (boosted > 0.62) return 2;
  if (boosted > 0.42) return 1;
  return 0;
});

const sz = 4, gap = 1, step = sz + gap;
const svgW = COLS * step, svgH = ROWS * step;
let miniGrid = `<svg width="${svgW}" height="${svgH}" viewBox="0 0 ${svgW} ${svgH}" xmlns="http://www.w3.org/2000/svg">`;
for (let w = 0; w < COLS; w++) {
  for (let d = 0; d < ROWS; d++) {
    const level = cells[w * ROWS + d];
    miniGrid += `<rect x="${w * step}" y="${d * step}" width="${sz}" height="${sz}" rx="1" fill="${pal[level]}"/>`;
  }
}
miniGrid += '</svg>';
---

<section class="section" id="widget">
  <div class="wrap">
    <div class="eyebrow"><span class="mono">06 — widget</span></div>
    <h2 class="section-title">
      Your streak.<br />
      <span class="dim">Always on your home screen.</span>
    </h2>

    <div class="widget-layout">

      <div class="phone-wrap" aria-label="Home screen widget preview">
        <div class="phone">
          <div class="phone-pill" aria-hidden="true"></div>
          <div class="phone-screen">
            <div class="home-glow" aria-hidden="true"></div>
            <div class="home-widgets">
              <div class="w-card w-medium" role="img" aria-label="Medium widget showing contribution grid">
                <div class="w-head">
                  <span class="mono w-name">torvalds</span>
                  <span class="w-streak">
                    <svg viewBox="0 0 12 14" width="9" height="11" fill="none" aria-hidden="true">
                      <path d="M6 1C4 5 2 6.5 2 9a4 4 0 0 0 8 0c0-2.5-1.5-4-2-6C7.5 5 7.5 6 6 7 5.2 6 5 4.5 6 1z" fill="var(--g-3)" stroke="none"/>
                    </svg>
                    <span class="mono">42</span>
                  </span>
                </div>
                <div class="w-grid">
                  <Fragment set:html={miniGrid} />
                </div>
                <div class="w-foot mono">1,234 contributions this year</div>
              </div>

              <div class="home-row">
                <div class="w-card w-small" role="img" aria-label="Small widget showing streak count">
                  <div class="ws-count mono">42</div>
                  <div class="ws-label mono">day streak</div>
                </div>
                <div class="app-icons" aria-hidden="true">
                  <span class="app-icon"></span>
                  <span class="app-icon"></span>
                  <span class="app-icon"></span>
                  <span class="app-icon ai-accent"></span>
                </div>
              </div>
            </div>
          </div>
          <div class="phone-bar" aria-hidden="true"></div>
        </div>
      </div>

      <div class="feat-list">
        <div class="feat">
          <div class="feat-icon">
            <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="5.5" y="1.5" width="9" height="17" rx="2"/>
              <path d="M8 16.5h4" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="feat-text">
            <div class="feat-title">iOS &amp; Android</div>
            <p class="feat-body">Native home screen widget for both platforms. Follows each OS's widget conventions and size grid.</p>
          </div>
        </div>
        <div class="feat">
          <div class="feat-icon">
            <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="2" y="2" width="7" height="7" rx="1.5"/>
              <rect x="11" y="2" width="7" height="7" rx="1.5"/>
              <rect x="2" y="11" width="7" height="7" rx="1.5"/>
              <rect x="11" y="11" width="7" height="7" rx="1.5"/>
            </svg>
          </div>
          <div class="feat-text">
            <div class="feat-title">Three sizes</div>
            <p class="feat-body">Small for a glanceable streak counter. Medium for the full calendar grid. Large for both at once.</p>
          </div>
        </div>
        <div class="feat">
          <div class="feat-icon">
            <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="10" cy="10" r="7.5"/>
              <path d="M10 6v4l2.5 2.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="feat-text">
            <div class="feat-title">Daily refresh</div>
            <p class="feat-body">Fetches once a day so the grid is always current without draining the battery.</p>
          </div>
        </div>
        <div class="feat">
          <div class="feat-icon">
            <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M4 10h2m4-4v2m4 2h2m-6 4v2" stroke-linecap="round"/>
              <circle cx="10" cy="10" r="7.5"/>
            </svg>
          </div>
          <div class="feat-text">
            <div class="feat-title">All palettes</div>
            <p class="feat-body">All 11 color palettes available. The widget matches whatever you set in the app.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .widget-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  @media (max-width: 900px) {
    .widget-layout { grid-template-columns: 1fr; gap: 40px; }
    .phone-wrap { display: flex; justify-content: center; }
  }

  /* ─── Phone frame ─────────────────────────────────────────── */
  .phone-wrap { display: flex; justify-content: center; }
  .phone {
    position: relative;
    width: 232px;
    background: #0d0d10;
    border: 1.5px solid var(--border);
    border-radius: 40px;
    padding: 16px 10px 22px;
    box-shadow:
      0 0 0 1px #000,
      0 40px 80px rgba(0,0,0,0.55),
      inset 0 1px 0 rgba(255,255,255,0.05);
  }
  .phone-pill {
    position: absolute; top: -1.5px; left: 50%; transform: translateX(-50%);
    width: 76px; height: 24px;
    background: #0d0d10;
    border: 1.5px solid var(--border);
    border-top-color: transparent;
    border-radius: 0 0 14px 14px;
  }
  .phone-screen {
    position: relative;
    background: linear-gradient(155deg, #101218 0%, #090b0f 100%);
    border-radius: 30px;
    overflow: hidden;
    padding: 28px 12px 16px;
    min-height: 390px;
  }
  .home-glow {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 160px 180px at 50% 20%, rgba(57,211,83,0.07), transparent 70%);
    pointer-events: none;
  }
  .phone-bar {
    width: 72px; height: 4px;
    border-radius: 999px;
    background: var(--border);
    margin: 10px auto 0;
  }

  /* ─── Home screen widgets ─────────────────────────────────── */
  .home-widgets { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 8px; }

  .w-card {
    background: rgba(255,255,255,0.045);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 18px;
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  .w-medium { padding: 12px 13px; display: flex; flex-direction: column; gap: 7px; }
  .w-head { display: flex; align-items: center; justify-content: space-between; }
  .w-name { font-size: 9.5px; color: rgba(255,255,255,0.35); }
  .w-streak {
    display: inline-flex; align-items: center; gap: 3px;
    padding: 2px 6px; border-radius: 999px;
    background: rgba(57,211,83,0.12); border: 1px solid rgba(57,211,83,0.18);
    color: var(--g-4); font-size: 9.5px;
  }
  .w-grid { line-height: 0; }
  .w-grid :global(svg) { border-radius: 2px; max-width: 100%; }
  .w-foot { font-size: 8.5px; color: rgba(255,255,255,0.25); }

  .home-row { display: flex; gap: 8px; align-items: flex-start; }
  .w-small {
    width: 80px; height: 80px; flex-shrink: 0;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 2px;
  }
  .ws-count { font-size: 24px; font-weight: 700; color: var(--g-4); line-height: 1; }
  .ws-label { font-size: 8px; color: rgba(255,255,255,0.3); }

  .app-icons { display: grid; grid-template-columns: repeat(2, 36px); gap: 6px; padding-top: 6px; }
  .app-icon {
    width: 36px; height: 36px; border-radius: 9px;
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.05);
  }
  .app-icon.ai-accent { background: rgba(57,211,83,0.12); border-color: rgba(57,211,83,0.15); }

  /* ─── Feature list ────────────────────────────────────────── */
  .feat-list { display: flex; flex-direction: column; }
  .feat {
    display: flex; gap: 16px; align-items: flex-start;
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
  }
  .feat:first-child { border-top: 1px solid var(--border); }
  .feat-icon {
    flex-shrink: 0;
    width: 32px; height: 32px;
    display: flex; align-items: center; justify-content: center;
    background: var(--bg-2); border: 1px solid var(--border-2); border-radius: 8px;
    color: var(--g-4); margin-top: 1px;
  }
  .feat-title { font-size: 14px; font-weight: 600; letter-spacing: -0.01em; margin-bottom: 4px; }
  .feat-body { margin: 0; font-size: 13px; color: var(--text-dim); line-height: 1.55; }
</style>
