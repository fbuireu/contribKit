---
---

<section class="section" id="how">
  <div class="wrap">
    <div class="eyebrow"><span class="mono">03 — flow</span></div>
    <h2 class="section-title">Four taps.<br /><span class="dim">Nothing else to learn.</span></h2>
    <div class="steps">

      <div class="step">
        <div class="step-head">
          <span class="mono step-n">01</span>
          <span class="step-rule" aria-hidden="true"></span>
        </div>
        <div class="step-glyph step-input" aria-hidden="true">
          <div class="mono dimmer">$</div>
          <div class="mono">contribkit <span class="accent">@torvalds</span></div>
          <div class="cursor"></div>
        </div>
        <h3 class="step-title">Enter username</h3>
        <p class="step-body">No OAuth, no personal access token. Just your handle.</p>
      </div>

      <div class="step">
        <div class="step-head">
          <span class="mono step-n">02</span>
          <span class="step-rule" aria-hidden="true"></span>
        </div>
        <div class="step-glyph step-customize" aria-hidden="true">
          <div class="chip-row">
            <span class="chip" style="background:#39D353"></span>
            <span class="chip" style="background:#7fb0ff"></span>
            <span class="chip" style="background:#f0a45a"></span>
            <span class="chip" style="background:#c8a8ff"></span>
          </div>
          <div class="shape-row">
            <span class="shape-tile sq"></span>
            <span class="shape-tile circ"></span>
            <span class="shape-tile dot"><i></i></span>
            <span class="shape-tile hex"></span>
          </div>
        </div>
        <h3 class="step-title">Customize</h3>
        <p class="step-body">Six palettes. Five shapes. Background, gradient, intensity, density.</p>
      </div>

      <div class="step">
        <div class="step-head">
          <span class="mono step-n">03</span>
          <span class="step-rule" aria-hidden="true"></span>
        </div>
        <div class="step-glyph step-export" aria-hidden="true">
          <div class="export-pill">
            <span class="mono">.png</span>
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 2v9m0 0l-3-3m3 3l3-3M3 13h10" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="export-pill">
            <span class="mono">.svg</span>
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 2v9m0 0l-3-3m3 3l3-3M3 13h10" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="export-pill">
            <span class="mono">.md</span>
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="5" width="9" height="9" rx="1.5"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"/></svg>
          </div>
        </div>
        <h3 class="step-title">Export</h3>
        <p class="step-body">PNG for the readme. SVG for the portfolio. Markdown for the bio.</p>
      </div>

      <div class="step">
        <div class="step-head">
          <span class="mono step-n">04</span>
          <span class="step-rule" aria-hidden="true"></span>
        </div>
        <div class="step-glyph step-widget" aria-hidden="true">
          <div class="widget-mock">
            <div class="wm-bar">
              <span class="wm-dot"></span>
              <span class="wm-user mono" id="how-widget-username">torvalds</span>
            </div>
            <div class="wm-cells">
              {Array.from({ length: 12 * 7 }, (_, i) => {
                const lvl = [0,0,1,0,2,1,0,3,1,0,2,4,1,0,1,2,0,3,1,0,1,0,2,1,3,2,0,1,0,0,2,0,1,3,2,1,0,1,0,2,3,1,0,1,0,2,1,0,0,3,2,1,0,1,2,0,1,3,0,2,1,0,1,2,3,0,1,2,0,1,3,2,0,1,0,1,2,3,4,2,1,0,1,2][i % 84];
                return <span class="wm-cell" data-level={lvl}></span>;
              })}
            </div>
            <div class="wm-foot mono">42 day streak</div>
          </div>
        </div>
        <h3 class="step-title">Pin the widget</h3>
        <p class="step-body">Add the home screen widget and your contribution streak is always one glance away.</p>
      </div>

    </div>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  @media (max-width: 1000px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }

  .step {
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    display: flex; flex-direction: column; gap: 16px;
    min-height: 240px;
  }
  .step-head { display: flex; align-items: center; gap: 12px; }
  .step-n { color: var(--g-4); font-size: 11px; }
  .step-rule {
    flex: 1; height: 1px;
    background: linear-gradient(to right, var(--border) 0%, transparent 100%);
  }
  .step-glyph {
    flex: 1;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-2);
    padding: 16px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 13px;
    min-height: 100px; position: relative;
  }
  .step-input { gap: 8px; display: flex; align-items: center; }
  .cursor {
    width: 7px; height: 14px;
    background: var(--g-4);
    animation: blink 1.1s steps(2) infinite;
  }
  @keyframes blink { 50% { opacity: 0.2; } }

  .step-customize { flex-direction: column; gap: 16px; }
  .chip-row { display: flex; gap: 6px; }
  .chip { width: 14px; height: 14px; border-radius: 50%; }
  .shape-row { display: flex; gap: 10px; align-items: center; }
  .shape-tile { width: 16px; height: 16px; background: var(--g-3); display: inline-block; }
  .shape-tile.sq { border-radius: 3px; }
  .shape-tile.circ { border-radius: 50%; }
  .shape-tile.dot {
    background: transparent;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .shape-tile.dot i {
    width: 6px; height: 6px; border-radius: 50%; background: var(--g-3); display: inline-block;
  }
  .shape-tile.hex {
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    background-color: var(--g-3);
  }

  .step-export { flex-direction: column; gap: 8px; width: 100%; }
  .export-pill {
    display: flex; align-items: center; justify-content: space-between;
    padding: 6px 10px;
    background: var(--bg-3); border: 1px solid var(--border-2); border-radius: 6px;
    font-size: 12px; width: 100%; max-width: 180px; color: var(--text-dim);
  }
  .export-pill :global(.mono) { color: var(--g-4); }

  .step-widget { flex-direction: column; gap: 8px; justify-content: center; }
  .widget-mock {
    width: 100%; max-width: 160px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 8px 10px;
    display: flex; flex-direction: column; gap: 6px;
  }
  .wm-bar { display: flex; align-items: center; gap: 6px; }
  .wm-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--g-3);
    box-shadow: 0 0 6px rgba(57,211,83,0.5);
  }
  .wm-user { font-size: 9px; color: var(--text-dimmer); }
  .wm-cells {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 2px;
  }
  .wm-cell {
    aspect-ratio: 1; border-radius: 1px;
  }
  .wm-cell[data-level="0"] { background: var(--g-0); }
  .wm-cell[data-level="1"] { background: var(--g-1); }
  .wm-cell[data-level="2"] { background: var(--g-2); }
  .wm-cell[data-level="3"] { background: var(--g-3); }
  .wm-cell[data-level="4"] { background: var(--g-4); }
  .wm-foot { font-size: 8px; color: var(--text-dimmer); }

  .step-title { font-size: 17px; font-weight: 600; letter-spacing: -0.01em; margin: 0; }
  .step-body { margin: -8px 0 0; color: var(--text-dim); font-size: 13.5px; line-height: 1.5; }
</style>
