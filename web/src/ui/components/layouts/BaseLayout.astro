---
import "../../styles/global.css";
import Font from "astro/components/Font.astro";
import CookieConsent from "../CookieConsent.astro";
import SEO from "../core/SEO.astro";
import Footer from "../Footer.astro";
import TopNav from "../TopNav.astro";

type RobotsDirective = "index, follow" | "noindex" | "noindex, nofollow" | "nofollow";

interface Props {
	title: string;
	description?: string;
	url?: string;
	image?: string;
	robots?: RobotsDirective;
}

const { title, description, url, image, robots } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      {
        const colorScheme = localStorage.getItem('color-scheme');
        if (colorScheme === 'light' || colorScheme === 'dark') {
          document.documentElement.classList.add(`theme-${colorScheme}`);
          document.querySelector('meta[name="color-scheme"]').content = colorScheme;
        }
      }
    </script>
    <SEO title={title} description={description} url={url} image={image} robots={robots} />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    <TopNav />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>
