---
import '../../styles/global.css';
import TopNav from '../TopNav.astro';
import Footer from '../Footer.astro';
import SEO from '../core/SEO.astro';

type RobotsDirective = 'index, follow' | 'noindex' | 'noindex, nofollow' | 'nofollow';

interface Props {
  title: string;
  description?: string;
  url?: string;
  image?: string;
  robots?: RobotsDirective;
}

const { title, description, url, image, robots } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      {
        const colorScheme = localStorage.getItem('color-scheme');
        if (colorScheme === 'light' || colorScheme === 'dark') {
          document.documentElement.classList.add(`theme-${colorScheme}`);
          document.querySelector('meta[name="color-scheme"]').content = colorScheme;
        }
      }
    </script>
    <SEO title={title} description={description} url={url} image={image} robots={robots} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <slot name="head" />
  </head>
  <body>
    <TopNav />
    <slot />
    <Footer />
  </body>
</html>
