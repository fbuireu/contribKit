---
import "../../styles/global.css";
import Font from "astro/components/Font.astro";
import CookieConsent from "../CookieConsent.astro";
import SEO from "../core/SEO.astro";
import Footer from "../Footer.astro";
import TopNav from "../TopNav.astro";

type RobotsDirective = "index, follow" | "noindex" | "noindex, nofollow" | "nofollow";

interface Props {
	title: string;
	description?: string;
	url?: string;
	image?: string;
	imageAlt?: string;
	robots?: RobotsDirective;
}

const { title, description, url, image, imageAlt, robots } = Astro.props;
const GA_ID = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      {
        const colorScheme = localStorage.getItem('color-scheme');
        if (colorScheme === 'light' || colorScheme === 'dark') {
          document.documentElement.classList.add(`theme-${colorScheme}`);
          document.querySelector('meta[name="color-scheme"]').content = colorScheme;
        }
      }
    </script>
    <SEO title={title} description={description} url={url} image={image} imageAlt={imageAlt} robots={robots} />
    {GA_ID && (
      <>
        <script is:inline define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;

          const analyticsConsent = (() => {
            try {
              const match = document.cookie.match(/(^| )cc_cookie=([^;]+)/);
              if (match) {
                const data = JSON.parse(decodeURIComponent(match[2]));
                return Array.isArray(data.categories) && data.categories.includes('analytics') ? 'granted' : 'denied';
              }
            } catch {}
            return 'denied';
          })();

          gtag('consent', 'default', { analytics_storage: analyticsConsent });
          gtag('js', new Date());
          gtag('config', GA_ID);
        </script>
        <script is:inline type="text/partytown" src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
      </>
    )}
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    <TopNav />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>
