---
import { ClassName, ElementId } from "../../utils/dom-contract";
import "./export.css";
import type { ContributionDay } from "@domain/entities/types";
import { FIRST_SUGGESTED_USERNAME } from "@domain/value-objects/username";
import { ExportFormatKey, exportTabDetail } from "./export-formats";

interface Props {
	exportSvg: string;
	days: readonly ContributionDay[];
}
const { exportSvg, days } = Astro.props;

const EXPORT_FORMATS = Object.values(ExportFormatKey).map((key) => ({ key, detail: exportTabDetail({ key, days }) }));
---

<section class="section" id={ElementId.ExportSection} aria-label="Export">
  <div class="wrap">
    <div class="eyebrow" aria-hidden="true"><span class="mono">export</span></div>
    <h2 class="section-title">
      Three formats.<br />
      <span class="dim">Pick the right one for the surface.</span>
    </h2>
    <div class="export-grid">
      <div class="export-tabs" id={ElementId.ExportTabs} role="tablist" aria-label="Export format">
        {EXPORT_FORMATS.map(({ key, detail }, index) => (
          <button
            class:list={['export-tab', { [ClassName.Active]: index === 0 }]}
            role="tab"
            id={`export-tab-${key}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={ElementId.ExportPreview}
            data-key={key}
          >
            <span class="mono tab-key">.{key}</span>
            <span class="tab-label">{key.toUpperCase()}</span>
            <span class={ClassName.ExportTabDetail}>{detail}</span>
          </button>
        ))}
      </div>
      <div class="export-preview" id={ElementId.ExportPreview} role="tabpanel" aria-labelledby="export-tab-png">
        <div class:list={[ClassName.PreviewCard, ClassName.PngPreview]}>
          <div class={ClassName.PreviewChecker} aria-hidden="true"></div>
          <div class={ClassName.PreviewContent}>
            <Fragment set:html={exportSvg} />
          </div>
          <div class:list={[ClassName.PreviewTag, "mono"]}>{FIRST_SUGGESTED_USERNAME}.png</div>
        </div>
      </div>
    </div>
  </div>
</section>
