---
import { ClassName, ElementId } from "@ui/utils/dom-contract";
import "./export.css";
import { DAYS_PER_WEEK, WEEKS_PER_YEAR } from "@domain/services/dates";
import { calendarLayout } from "@domain/services/svg-geometry";
import { DEFAULT_CELL_SHAPE } from "@domain/value-objects/cell-shape";
import { DEFAULT_USERNAME } from "@domain/value-objects/username";
import { EXPORT_GRID_PRESET } from "@ui/components/grid/grid-presets";
import { ExportFormatKey } from "./export-formats";

interface Props {
	exportSvg: string;
}
const { exportSvg } = Astro.props;

const exportLayout = calendarLayout({
	days: [],
	shape: DEFAULT_CELL_SHAPE,
	...EXPORT_GRID_PRESET,
	showLabels: false,
});

const EXPORT_FORMATS = [
	{
		key: ExportFormatKey.Png,
		detail: `${exportLayout.width}×${exportLayout.height} · transparent`,
	},
	{ key: ExportFormatKey.Svg, detail: `Vector · ${WEEKS_PER_YEAR}×${DAYS_PER_WEEK} grid` },
	{ key: ExportFormatKey.Md, detail: "Live embed, re-renders on view" },
] as const;
---

<section class="section" id="export" aria-label="Export">
  <div class="wrap">
    <div class="eyebrow" aria-hidden="true"><span class="mono">export</span></div>
    <h2 class="section-title">
      Three formats.<br />
      <span class="dim">Pick the right one for the surface.</span>
    </h2>
    <div class="export-grid">
      <div class="export-tabs" id={ElementId.ExportTabs} role="tablist" aria-label="Export format">
        {EXPORT_FORMATS.map(({ key, detail }, index) => (
          <button
            class:list={['export-tab', { active: index === 0 }]}
            role="tab"
            id={`export-tab-${key}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={ElementId.ExportPreview}
            data-key={key}
          >
            <span class="mono tab-key">.{key}</span>
            <span class="tab-label">{key.toUpperCase()}</span>
            <span class="tab-detail">{detail}</span>
          </button>
        ))}
      </div>
      <div class="export-preview" id={ElementId.ExportPreview} role="tabpanel" aria-labelledby="export-tab-png">
        <div class={`preview-card ${ClassName.PngPreview}`}>
          <div class="preview-checker" aria-hidden="true"></div>
          <div class="preview-content">
            <Fragment set:html={exportSvg} />
          </div>
          <div class="preview-tag mono">{DEFAULT_USERNAME}.png</div>
        </div>
      </div>
    </div>
  </div>
</section>
