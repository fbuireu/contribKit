---
import "./export.css";

interface Props {
	exportSvg: string;
}
const { exportSvg } = Astro.props;

const ExportFormatKey = {
	Png: "png",
	Svg: "svg",
	Md: "md",
} as const;

const EXPORT_FORMATS = [
	{ key: ExportFormatKey.Png, detail: "2880×720 · transparent", size: "186 KB" },
	{ key: ExportFormatKey.Svg, detail: "Vector · 53×7 grid", size: "24 KB" },
	{ key: ExportFormatKey.Md, detail: "GitHub-flavored embed", size: "410 B" },
] as const;
---

<section class="section" id="export" aria-label="Export">
  <div class="wrap">
    <div class="eyebrow" aria-hidden="true"><span class="mono">export</span></div>
    <h2 class="section-title">
      Three formats.<br />
      <span class="dim">Pick the right one for the surface.</span>
    </h2>
    <div class="export-grid">
      <div class="export-tabs" id="export-tabs" role="tablist" aria-label="Export format">
        {EXPORT_FORMATS.map(({ key, detail, size }, index) => (
          <button
            class:list={['export-tab', { active: index === 0 }]}
            role="tab"
            id={`export-tab-${key}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls="export-preview"
            data-key={key}
          >
            <span class="mono tab-key">.{key}</span>
            <span class="tab-label">{key.toUpperCase()}</span>
            <span class="tab-detail">{detail}</span>
            <span class="mono dimmer tab-size">{size}</span>
          </button>
        ))}
      </div>
      <div class="export-preview" id="export-preview" role="tabpanel" aria-labelledby="export-tab-png">
        <div class="preview-card png-preview">
          <div class="preview-checker" aria-hidden="true"></div>
          <div class="preview-content">
            <Fragment set:html={exportSvg} />
          </div>
          <div class="preview-tag mono">torvalds.png</div>
        </div>
      </div>
    </div>
  </div>
</section>
