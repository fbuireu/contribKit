---
import "./widget.css";
import { PALETTES } from "@domain/value-objects/palette";
import { DEFAULT_USERNAME } from "@domain/value-objects/username";
import { generateMiniGrid } from "@ui/components/grid/mini-grid";
import Clock from "@ui/components/icons/Clock.astro";
import Flame from "@ui/components/icons/Flame.astro";
import Grid from "@ui/components/icons/Grid.astro";
import Palette from "@ui/components/icons/Palette.astro";
import Phone from "@ui/components/icons/Phone.astro";

const miniGrid = generateMiniGrid({ palette: PALETTES.github.colors });
---

<section class="section" id="widget" aria-label="Widget">
  <div class="wrap">
    <div class="eyebrow" aria-hidden="true"><span class="mono">widget</span></div>
    <h2 class="section-title">
      Your streak.<br />
      <span class="dim">Always on your home screen.</span>
    </h2>

    <div class="widget-layout">

      <div class="phone-wrap" aria-label="Home screen widget preview">
        <div class="phone">
          <div class="phone-pill" aria-hidden="true"></div>
          <div class="phone-screen" id="phone-screen">
            <div class="home-glow" aria-hidden="true"></div>
            <div class="home-widgets">
              <div class="w-card w-medium" role="img" aria-label="Medium widget showing contribution grid">
                <div class="w-head">
                  <span class="mono w-name" id="widget-username">{DEFAULT_USERNAME}</span>
                  <span class="w-streak">
                    <Flame />
                    <span class="mono">42</span>
                  </span>
                </div>
                <div class="w-grid" id="widget-mini-grid">
                  <Fragment set:html={miniGrid} />
                </div>
                <div class="w-foot mono">1,234 contributions this year</div>
              </div>

              <div class="home-row">
                <div class="w-card w-small" role="img" aria-label="Small widget showing streak count">
                  <div class="ws-count mono">42</div>
                  <div class="ws-label mono">day streak</div>
                </div>
                <div class="app-icons" aria-hidden="true">
                  <span class="app-icon"></span>
                  <span class="app-icon"></span>
                  <span class="app-icon"></span>
                  <span class="app-icon ai-accent"></span>
                </div>
              </div>
            </div>
          </div>
          <div class="phone-bar" aria-hidden="true"></div>
        </div>
      </div>

      <div class="feat-list">
        <div class="feat">
          <div class="feat-icon">
            <Phone />
          </div>
          <div class="feat-text">
            <h3 class="feat-title">iOS &amp; Android</h3>
            <p class="feat-body">Native home screen widget for both platforms. Follows each OS's widget conventions and size grid.</p>
          </div>
        </div>
        <div class="feat">
          <div class="feat-icon">
            <Grid />
          </div>
          <div class="feat-text">
            <h3 class="feat-title">Three sizes</h3>
            <p class="feat-body">Small for a glanceable streak counter. Medium for the full calendar grid. Large for both at once.</p>
          </div>
        </div>
        <div class="feat">
          <div class="feat-icon">
            <Clock />
          </div>
          <div class="feat-text">
            <h3 class="feat-title">Daily refresh</h3>
            <p class="feat-body">Fetches once a day so the grid is always current without draining the battery.</p>
          </div>
        </div>
        <div class="feat">
          <div class="feat-icon">
            <Palette />
          </div>
          <div class="feat-text">
            <h3 class="feat-title">All palettes</h3>
            <p class="feat-body">All 11 color palettes available. The widget matches whatever you set in the app.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

