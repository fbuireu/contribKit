---
import '../styles/components/export.css';

interface Props {
  exportPNGSVG: string;
}
const { exportPNGSVG } = Astro.props;
---

<section class="section" id="export">
  <div class="wrap">
    <div class="eyebrow"><span class="mono">export</span></div>
    <h2 class="section-title">
      Three formats.<br />
      <span class="dim">Pick the right one for the surface.</span>
    </h2>
    <div class="export-grid">
      <div class="export-tabs" id="export-tabs" role="tablist" aria-label="Export format"></div>
      <div class="export-preview" id="export-preview" role="tabpanel">
        <div class="preview-card png-preview">
          <div class="preview-checker" aria-hidden="true"></div>
          <div class="preview-content">
            <Fragment set:html={exportPNGSVG} />
          </div>
          <div class="preview-tag mono">torvalds.png</div>
        </div>
      </div>
    </div>
  </div>
</section>

