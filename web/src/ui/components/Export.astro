---
import './export.css';

interface Props {
  exportPNGSVG: string;
}
const { exportPNGSVG } = Astro.props;

const EXPORT_FORMATS = [
  { key: 'png', label: 'PNG', detail: '2880×720 · transparent', size: '186 KB' },
  { key: 'svg', label: 'SVG', detail: 'Vector · 53×7 grid',     size: '24 KB' },
  { key: 'md',  label: 'MD',  detail: 'GitHub-flavored embed',   size: '410 B' },
] as const;
---

<section class="section" id="export">
  <div class="wrap">
    <div class="eyebrow"><span class="mono">export</span></div>
    <h2 class="section-title">
      Three formats.<br />
      <span class="dim">Pick the right one for the surface.</span>
    </h2>
    <div class="export-grid">
      <div class="export-tabs" id="export-tabs" role="tablist" aria-label="Export format">
        {EXPORT_FORMATS.map(({ key, label, detail, size }, i) => (
          <button
            class:list={['export-tab', { active: i === 0 }]}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-key={key}
          >
            <span class="mono tab-key">.{key}</span>
            <span class="tab-label">{label}</span>
            <span class="tab-detail">{detail}</span>
            <span class="mono dimmer tab-size">{size}</span>
          </button>
        ))}
      </div>
      <div class="export-preview" id="export-preview" role="tabpanel">
        <div class="preview-card png-preview">
          <div class="preview-checker" aria-hidden="true"></div>
          <div class="preview-content">
            <Fragment set:html={exportPNGSVG} />
          </div>
          <div class="preview-tag mono">torvalds.png</div>
        </div>
      </div>
    </div>
  </div>
</section>
