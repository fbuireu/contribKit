---
import { ElementId } from "../../utils/dom-contract";
import "./how-it-works.css";
import { CELL_SHAPES } from "@domain/value-objects/cell-shape";
import { PALETTES } from "@domain/value-objects/palette";
import { FIRST_SUGGESTED_USERNAME } from "@domain/value-objects/username";
import Copy from "../icons/Copy.astro";
import Download from "../icons/Download.astro";

const HOME_SCREEN_WIDGET_DEMO_LEVELS = [
	0, 0, 1, 0, 2, 1, 0, 3, 1, 0, 2, 4, 1, 0, 1, 2, 0, 3, 1, 0, 1, 0, 2, 1, 3, 2, 0, 1, 0, 0, 2, 0, 1, 3, 2, 1, 0, 1, 0,
	2, 3, 1, 0, 1, 0, 2, 1, 0, 0, 3, 2, 1, 0, 1, 2, 0, 1, 3, 0, 2, 1, 0, 1, 2, 3, 0, 1, 2, 0, 1, 3, 2, 0, 1, 0, 1, 2, 3,
	4, 2, 1, 0, 1, 2,
];
---

<section class="section" id={ElementId.HowItWorksSection} aria-label="How it works">
  <div class="wrap">
    <div class="eyebrow" aria-hidden="true"><span class="mono">flow</span></div>
    <h2 class="section-title">Four taps.<br /><span class="dim">Nothing else to learn.</span></h2>
    <div class="steps">

      <div class="step">
        <div class="step-head">
          <span class="mono step-n" aria-hidden="true"></span>
          <span class="step-rule" aria-hidden="true"></span>
        </div>
        <div class="step-glyph step-input" aria-hidden="true">
          <div class="mono dimmer">$</div>
          <div class="mono">contribKit <span class="accent">@{FIRST_SUGGESTED_USERNAME}</span></div>
          <div class="cursor"></div>
        </div>
        <h3 class="step-title">Enter username</h3>
        <p class="step-body">No OAuth, no personal access token. Just your username.</p>
      </div>

      <div class="step">
        <div class="step-head">
          <span class="mono step-n" aria-hidden="true"></span>
          <span class="step-rule" aria-hidden="true"></span>
        </div>
        <div class="step-glyph step-customize" aria-hidden="true">
          <div class="shape-row">
            <span class="shape-tile sq"></span>
            <span class="shape-tile circ"></span>
            <span class="shape-tile dot"><i></i></span>
            <span class="shape-tile hex"></span>
          </div>
        </div>
        <h3 class="step-title">Customize</h3>
        <p class="step-body">{Object.keys(PALETTES).length} palettes. {CELL_SHAPES.length} shapes. Cell Size and Background in the app.</p>
      </div>

      <div class="step">
        <div class="step-head">
          <span class="mono step-n" aria-hidden="true"></span>
          <span class="step-rule" aria-hidden="true"></span>
        </div>
        <div class="step-glyph step-export" aria-hidden="true">
          <div class="export-pill">
            <span class="mono">.png</span>
            <Download />
          </div>
          <div class="export-pill">
            <span class="mono">.svg</span>
            <Copy />
          </div>
          <div class="export-pill">
            <span class="mono">.md</span>
            <Copy />
          </div>
        </div>
        <h3 class="step-title">Export</h3>
        <p class="step-body">PNG for the readme. SVG for the portfolio. Markdown for the bio.</p>
      </div>

      <div class="step">
        <div class="step-head">
          <span class="mono step-n" aria-hidden="true"></span>
          <span class="step-rule" aria-hidden="true"></span>
        </div>
        <div class="step-glyph step-widget" aria-hidden="true">
          <div class="widget-mock">
            <div class="wm-bar">
              <span class="wm-dot"></span>
              <span class="wm-user mono">your username</span>
            </div>
            <div class="wm-cells">
              {HOME_SCREEN_WIDGET_DEMO_LEVELS.map((level) => (
                <span class="wm-cell" data-level={level}></span>
              ))}
            </div>
            <div class="wm-foot mono">42 day streak</div>
          </div>
        </div>
        <h3 class="step-title">Pin the home screen widget</h3>
        <p class="step-body">Add it and your streak is always in view.</p>
      </div>

    </div>
  </div>
</section>

