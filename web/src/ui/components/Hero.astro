---
interface Props {
  heroSVG: string;
  summary: { count: number; streak: number; longest: number };
  palette: string[];
}
const { heroSVG, summary, palette } = Astro.props;
---

<section class="hero">
  <div class="hero-grain" aria-hidden="true"></div>
  <div class="wrap">

    <div class="meta">
      <span class="badge">
        <span class="badge-dot" aria-hidden="true"></span>
        v1.0 · available on iOS &amp; Android
      </span>
    </div>

    <h1 class="display">
      Your GitHub activity.<br />
      <span class="display-accent">Your aesthetic.</span>
    </h1>
    <p class="lede">
      Visualize, customize, and export your contribution calendar &mdash; no token required.
    </p>

    <div class="cta-row">
      <a href="#" class="btn btn-store" aria-label="Download on the App Store">
        <svg viewBox="0 0 814 1000" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76 0-103.7 40.8-165.9 40.8s-105-57.8-155.5-127.4C46 790.7 0 663 0 541.8c0-207.1 134.7-316.7 267.9-316.7 70.8 0 129.7 46.4 173.2 46.4 42.8 0 109.7-49 191.5-49 30.8 0 108.2 2.6 168.1 75.4zm-198-220.6c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/>
        </svg>
        <span>
          <small>Download on the</small>
          App Store
        </span>
      </a>
      <a href="#" class="btn btn-store" aria-label="Get it on Google Play">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
          <path d="M3.18 23.76c.3.17.64.24.98.21l11.58-11.58L12.06 9l-8.88 14.76z" fill="#EA4335"/>
          <path d="M20.84 10.32l-2.92-1.67-3.27 3.27 3.27 3.27 2.95-1.69c.84-.48.84-1.68-.03-2.18z" fill="#FBBC04"/>
          <path d="M3.18.24C2.8.45 2.54.87 2.54 1.43v21.14c0 .56.26.98.64 1.19l12.02-12.02L3.18.24z" fill="#4285F4"/>
          <path d="M4.16.45l11.04 11.05-3.14 3.14L3.18 23.76c.34.03.68-.04.98-.21L20.81 13.5c.84-.48.84-1.69 0-2.18L5.16.24C4.84.06 4.48.08 4.16.45z" fill="#34A853"/>
        </svg>
        <span>
          <small>Get it on</small>
          Google Play
        </span>
      </a>
    </div>

    <div class="username-strip" aria-label="Preview username">
      <span class="us-label">github.com/</span>
      <input class="us-input" id="hero-username" value="torvalds" spellcheck="false" autocomplete="off" />
      <div class="us-year-wrap">
        <select class="us-year" id="hero-year" aria-label="Year">
          {Array.from({ length: new Date().getFullYear() - 2005 + 1 }, (_, i) => new Date().getFullYear() - i).map(y => (
            <option value={y}>{y}</option>
          ))}
        </select>
        <span class="us-year-chevron" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </div>
      <button class="us-go" id="hero-render-btn" type="button">
        render
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <div class="suggestions" aria-label="Try a famous GitHub profile">
      <span class="mono sug-label">try:</span>
      <button class="sug-btn mono" data-username="torvalds">torvalds</button>
      <button class="sug-btn mono" data-username="gaearon">gaearon</button>
      <button class="sug-btn mono" data-username="yyx990803">yyx990803</button>
      <button class="sug-btn mono" data-username="sindresorhus">sindresorhus</button>
      <button class="sug-btn mono" data-username="antirez">antirez</button>
    </div>

    <p class="hero-error" id="hero-error" aria-live="polite" hidden></p>

    <div class="hero-stage">
      <div class="hero-card">
        <div class="hero-card-bar">
          <div class="bar-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <div class="bar-title">
            <span class="mono dim" id="hero-username-display">torvalds</span>
            <span class="mono dimmer">·</span>
            <span class="mono dim" id="hero-year-range">last year</span>
          </div>
          <div class="bar-tag">
            <span class="mono">{summary.count.toLocaleString()}</span> contributions
          </div>
        </div>
        <div class="hero-card-body" id="hero-grid-container">
          <Fragment set:html={heroSVG} />
        </div>
        <div class="hero-card-foot">
          <div class="legend" aria-label="Contribution level legend">
            <span class="mono dimmer">less</span>
            {palette.map((c) => (
              <span class="legend-sq" style={`background:${c};border-radius:2px`} aria-hidden="true"></span>
            ))}
            <span class="mono dimmer">more</span>
          </div>
          <div class="legend-stats">
            <span><b class="mono">{summary.streak}</b> day streak</span>
            <span class="sep">·</span>
            <span><b class="mono">{summary.longest}</b> longest</span>
          </div>
        </div>
      </div>
      <div class="hero-card-glow" aria-hidden="true"></div>
    </div>

  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 80px 0 96px;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .hero-grain {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 800px 400px at 50% -10%, rgba(57,211,83,0.10), transparent 60%),
      radial-gradient(ellipse 600px 300px at 50% 100%, rgba(57,211,83,0.04), transparent 60%);
    pointer-events: none;
  }
  .meta { margin-bottom: 28px; }
  .badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 5px 10px 5px 8px;
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 0.02em;
    color: var(--text-dim);
    background: var(--bg-2);
    border: 1px solid var(--border-2);
    border-radius: 999px;
  }
  .badge-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--g-4);
    box-shadow: 0 0 8px rgba(57,211,83,0.6);
  }
  .display {
    font-size: clamp(36px, 6.5vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 700;
    margin: 0 0 20px;
    text-wrap: balance;
  }
  .display-accent { color: var(--text-dim); }
  .lede {
    font-size: clamp(15px, 1.8vw, 18px);
    color: var(--text-dim);
    max-width: 540px;
    margin: 0 0 32px;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .cta-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .btn {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 10px 16px 10px 14px;
    border-radius: 8px;
    font-weight: 500; font-size: 14px;
    border: 1px solid transparent;
    transition: background 120ms, border-color 120ms, transform 120ms;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn span { display: flex; flex-direction: column; line-height: 1.1; text-align: left; }
  .btn small { font-size: 10px; opacity: 0.8; font-weight: 400; }
  .btn-store { background: #000; color: #fff; border-color: #333; }
  .btn-store:hover { background: #1a1a1a; }

  .username-strip {
    display: inline-flex; align-items: stretch;
    background: var(--bg-2);
    border: 1px solid var(--border-2);
    border-radius: 8px;
    font-family: var(--font-mono); font-size: 13px;
    overflow: hidden; margin-bottom: 48px;
  }
  .us-label { padding: 10px 4px 10px 14px; color: var(--text-dimmer); }
  .us-input { padding: 10px 8px 10px 0; min-width: 120px; color: var(--g-4); }
  .us-sep {
    width: 1px; background: var(--border-2); align-self: stretch;
  }
  .us-year-wrap {
    position: relative;
    display: flex; align-items: center;
    border-left: 1px solid var(--border-2);
  }
  .us-year {
    padding: 0 28px 0 12px;
    height: 100%;
    background: transparent;
    color: var(--text-dim);
    border: none;
    font-family: var(--font-mono); font-size: 13px;
    cursor: pointer;
    appearance: none; -webkit-appearance: none;
    transition: color 120ms;
  }
  .us-year:hover, .us-year:focus { color: var(--text); outline: none; }
  .us-year option { background: var(--bg-3); color: var(--text); }
  .us-year-chevron {
    position: absolute; right: 8px;
    pointer-events: none; color: var(--text-dimmer);
    display: flex; align-items: center;
  }
  .us-go {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 0 14px;
    border-left: 1px solid var(--border-2);
    background: var(--bg-3); color: var(--text);
    transition: background 120ms;
  }
  .us-go:hover { background: #1f1f24; }

  .hero-stage { position: relative; margin-top: 8px; }
  .hero-card {
    position: relative;
    background: linear-gradient(180deg, #0c0c0f 0%, #0a0a0d 100%);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 16px 18px 14px;
    z-index: 1;
  }
  .hero-card-glow {
    position: absolute; inset: -1px;
    border-radius: 14px;
    background: radial-gradient(ellipse 60% 80% at 50% 50%, rgba(57,211,83,0.18), transparent 70%);
    filter: blur(40px);
    z-index: 0; pointer-events: none;
  }
  .hero-card-bar {
    display: flex; align-items: center; gap: 16px;
    padding-bottom: 14px; border-bottom: 1px solid var(--border); margin-bottom: 16px;
  }
  .bar-dots { display: flex; gap: 6px; }
  .bar-dots span {
    width: 9px; height: 9px; border-radius: 50%;
  }
  .bar-dots span:nth-child(1) { background: #FF5F57; }
  .bar-dots span:nth-child(2) { background: #FEBC2E; }
  .bar-dots span:nth-child(3) { background: #28C840; }
  .bar-title { font-size: 12px; display: flex; gap: 6px; align-items: center; margin-right: auto; }
  .bar-tag {
    font-size: 12px; color: var(--text-dim);
    padding: 4px 10px; background: var(--bg-2); border: 1px solid var(--border-2); border-radius: 999px;
  }
  .bar-tag :global(.mono) { color: var(--g-4); }
  .hero-card-body { padding: 4px 0 6px; overflow-x: auto; }
  .hero-card-foot {
    display: flex; justify-content: space-between; align-items: center;
    padding-top: 12px; border-top: 1px solid var(--border);
    font-size: 11px; color: var(--text-dim);
  }
  .legend { display: flex; align-items: center; gap: 5px; }
  .legend-sq { width: 11px; height: 11px; display: inline-block; }
  .legend-stats { display: flex; gap: 8px; align-items: center; }
  .legend-stats b { color: var(--text); font-weight: 500; }
  .legend-stats .sep { color: var(--text-faint); }

  .suggestions {
    display: flex; align-items: center; flex-wrap: wrap; gap: 6px;
    margin: -36px 0 20px;
  }
  .sug-label { font-size: 11px; color: var(--text-dimmer); margin-right: 2px; }
  .sug-btn {
    font-size: 11px; color: var(--text-dim);
    padding: 3px 10px;
    background: var(--bg-2); border: 1px solid var(--border-2); border-radius: 999px;
    transition: background 100ms, color 100ms, border-color 100ms;
  }
  .sug-btn:hover { background: var(--bg-3); color: var(--text); border-color: var(--border); }

  .hero-error {
    font-family: var(--font-mono); font-size: 12px;
    color: #f87171;
    margin: -36px 0 20px;
  }
  @media (max-width: 600px) {
    .hero { padding: 56px 0 64px; }
    .hero-card { padding: 12px 12px 10px; }
    .bar-title { font-size: 11px; }
    .legend-stats { display: none; }
  }
</style>
