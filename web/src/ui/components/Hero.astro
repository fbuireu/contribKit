---
import "./hero.css";
import AppStore from "./icons/AppStore.astro";
import ArrowRight from "./icons/ArrowRight.astro";
import ChevronDown from "./icons/ChevronDown.astro";
import GooglePlay from "./icons/GooglePlay.astro";

const GITHUB_START = 2005;
const currentYear = new Date().getFullYear();

interface Props {
	heroSVG: string;
	summary: { count: number; streak: number; longest: number };
	palette: string[];
	username: string;
	year?: number;
	error?: string | null;
}
const { heroSVG, summary, palette, username, year = currentYear, error = null } = Astro.props;
---

<section class="hero" aria-label="Hero">
  <div class="hero-grain" aria-hidden="true"></div>
  <div class="wrap">

    <div class="meta">
      <span class="badge">
        <span class="badge-dot" aria-hidden="true"></span>
        v1.0 · available on iOS &amp; Android
      </span>
    </div>

    <h1 class="display">
      Your GitHub activity.<br />
      <span class="display-accent">Your aesthetic.</span>
    </h1>
    <p class="lede">
      Visualize, customize, and export your contribution calendar &mdash; no token required.
    </p>

    <div class="cta-row">
      <button type="button" class="btn btn-store btn-store--soon" aria-label="App Store — coming soon" disabled aria-disabled="true">
        <AppStore />
        <span>
          <small>Coming soon to the</small>
          App Store
        </span>
      </button>
      <button type="button" class="btn btn-store" aria-label="Get it on Google Play">
        <GooglePlay />
        <span>
          <small>Get it on</small>
          Google Play
        </span>
      </button>
    </div>

    <form id="username-form" role="search" aria-label="Render GitHub contributions">
      <div class="username-strip">
        <label for="hero-username" class="us-label sr-only">GitHub username</label>
        <span class="us-label" aria-hidden="true">github.com/</span>
        <input class="us-input" id="hero-username" type="search" value={username} spellcheck="false" autocomplete="off" />
        <div class="us-year-wrap">
          <select class="us-year" id="hero-year" aria-label="Year">
            {Array.from({ length: currentYear - GITHUB_START + 1 }, (_, i) => currentYear - i).map(y => (
              <option value={y} selected={y === year}>{y}</option>
            ))}
          </select>
          <span class="us-year-chevron" aria-hidden="true">
            <ChevronDown />
          </span>
        </div>
        <button class="us-go" id="hero-render-btn" type="button">
          <span id="hero-render-label">render</span>
          <ArrowRight />
        </button>
      </div>
    </form>

    <div class="suggestions" role="group" aria-label="Try a famous GitHub profile">
      <span class="mono sug-label" aria-hidden="true">try:</span>
      <button class="sug-btn mono" data-username="torvalds">torvalds</button>
      <button class="sug-btn mono" data-username="gaearon">gaearon</button>
      <button class="sug-btn mono" data-username="yyx990803">yyx990803</button>
      <button class="sug-btn mono" data-username="sindresorhus">sindresorhus</button>
      <button class="sug-btn mono" data-username="antirez">antirez</button>
      <button class="sug-btn mono" data-username="fbuireu">fbuireu</button>
    </div>

    <p class="hero-error" id="hero-error" aria-live="polite" hidden={!error}>{error ? `↳ ${error}` : ""}</p>

    <div class="hero-stage">
      <div class="hero-card">
        <div class="hero-card-bar">
          <div class="bar-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <div class="bar-title">
            <span class="mono dim" id="hero-username-display">{username}</span>
            <span class="mono dimmer" aria-hidden="true">·</span>
            <span class="mono dim" id="hero-year-range">last year</span>
          </div>
          <div class="bar-tag">
            <span class="mono">{summary.count.toLocaleString()}</span> contributions
          </div>
        </div>
        <div class="hero-card-body" id="hero-grid-container">
          <Fragment set:html={heroSVG} />
        </div>
        <div class="hero-card-foot">
          <div class="legend" role="img" aria-label="Contribution level: less to more">
            <span class="mono dimmer" aria-hidden="true">less</span>
            {palette.map((c) => (
              <span class="legend-sq" style={`background:${c};border-radius:0.125rem`} aria-hidden="true"></span>
            ))}
            <span class="mono dimmer" aria-hidden="true">more</span>
          </div>
          <div class="legend-stats">
            <span><b class="mono">{summary.streak}</b> day streak</span>
            <span class="sep" aria-hidden="true">·</span>
            <span><b class="mono">{summary.longest}</b> longest</span>
          </div>
        </div>
      </div>
      <div class="hero-card-glow" aria-hidden="true"></div>
    </div>

  </div>
</section>
