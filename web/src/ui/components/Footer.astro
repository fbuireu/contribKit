          </svg>
          github
        </a>
        <a href="#" class="foot-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M17.05 12.04c-.02-2.43 1.99-3.6 2.08-3.66-1.13-1.66-2.9-1.89-3.53-1.92-1.5-.15-2.93.88-3.69.88-.77 0-1.94-.86-3.19-.84-1.64.02-3.16.95-4 2.42-1.71 2.96-.44 7.34 1.22 9.74.82 1.18 1.79 2.5 3.07 2.45 1.24-.05 1.7-.79 3.2-.79s1.92.79 3.22.77c1.33-.02 2.17-1.19 2.98-2.38.94-1.37 1.33-2.7 1.35-2.77-.03-.01-2.59-.99-2.61-3.9zM14.6 4.5c.68-.83 1.14-1.97 1.02-3.12-.98.04-2.18.65-2.88 1.47-.63.73-1.18 1.9-1.04 3.02 1.1.09 2.21-.55 2.9-1.37z"/>
          </svg>
          app store
        </a>
        <a href="#" class="foot-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M5.2 8.4C4.5 8.4 4 8.96 4 9.66v5.36c0 .7.5 1.27 1.2 1.27s1.2-.57 1.2-1.27V9.66c0-.7-.5-1.26-1.2-1.26zm13.6 0c-.7 0-1.2.56-1.2 1.26v5.36c0 .7.5 1.27 1.2 1.27s1.2-.57 1.2-1.27V9.66c0-.7-.5-1.26-1.2-1.26zM7 17.5c0 .55.45 1 1 1h.8v2.3c0 .67.53 1.2 1.2 1.2s1.2-.53 1.2-1.2v-2.3h1.6v2.3c0 .67.53 1.2 1.2 1.2s1.2-.53 1.2-1.2v-2.3H16c.55 0 1-.45 1-1V8.4H7v9.1zM14.62 4.5l.85-1.27a.3.3 0 0 0-.07-.42.3.3 0 0 0-.42.07l-.96 1.43A6.95 6.95 0 0 0 12 4c-.74 0-1.43.12-2.02.31l-.96-1.43a.3.3 0 0 0-.42-.07.3.3 0 0 0-.07.42l.85 1.27C7.85 5.31 7 6.78 7 8.4h10c0-1.62-.85-3.09-2.38-3.9zM10 7c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5zm4 0c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5z"/>
          </svg>
          play store
        </a>
      </div>
    </div>
    <div class="foot-bot">
      <span class="mono dimmer">© 2026 contribkit · v{pkg.version}</span>
      <div class="foot-legal">
        <a href="/privacy" class="legal-link mono">privacy</a>
        <span class="dimmer">·</span>
        <a href="/terms" class="legal-link mono">terms</a>
        <span class="dimmer">·</span>
        <span class="mono dimmer">not affiliated with github, inc.</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer { padding: 48px 0 32px; }
  .foot-top {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: 24px; border-bottom: 1px solid var(--border);
    flex-wrap: wrap; gap: 16px;
  }
  .foot-brand { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; }
  .brand-name { font-size: 15px; }
  .foot-links { display: flex; gap: 4px; }
  .foot-link {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 13px; color: var(--text-dim);
    padding: 8px 12px; border-radius: 6px; transition: background 100ms;
  }
  .foot-link:hover { background: var(--bg-2); color: var(--text); }
  .foot-bot {
    display: flex; justify-content: space-between; align-items: center;
    padding-top: 20px; font-size: 11px; flex-wrap: wrap; gap: 8px;
  }
  .foot-legal { display: flex; align-items: center; gap: 8px; }
  .legal-link { color: var(--text-dimmer); transition: color 100ms; }
  .legal-link:hover { color: var(--text); }
</style>
