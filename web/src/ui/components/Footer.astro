---
import "./footer.css";
import pkg from "../../../package.json";
import Apple from "./icons/Apple.astro";
import GitHub from "./icons/GitHub.astro";
import PlayStore from "./icons/PlayStore.astro";
---

<footer class="footer">
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <img src="/logo.svg" width="28" height="28" alt="" aria-hidden="true" style="border-radius:6px" />
        <span class="brand-name">ContribKit</span>
      </div>
      <div class="foot-links">
        <a href="https://github.com/fbuireu/contribkit" class="foot-link" target="_blank" rel="noopener noreferrer">
          <GitHub />
          github
        </a>
        <a href="#" class="foot-link">
          <Apple />
          app store
        </a>
        <a href="#" class="foot-link">
          <PlayStore />
          play store
        </a>
      </div>
    </div>
    <div class="foot-bot">
      <span class="mono dimmer">© 2026 contribkit · v{pkg.version}</span>
      <span class="mono dimmer">crafted commit by commit by <a href="https://github.com/fbuireu" class="legal-link mono" target="_blank" rel="noopener noreferrer">Ferran Buireu</a> · also <a href="https://github.com/fbuireu/forever-pto" class="legal-link mono" target="_blank" rel="noopener noreferrer">forever-pto</a></span>
      <div class="foot-legal">
        <a href="/legal-notice" class="legal-link mono">legal notice</a>
        <span class="dimmer">·</span>
        <a href="/privacy" class="legal-link mono">privacy</a>
        <span class="dimmer">·</span>
        <a href="/terms" class="legal-link mono">terms</a>
        <span class="dimmer">·</span>
        <button type="button" data-cc="show-preferencesModal" class="legal-link mono cookies-btn">cookies</button>
        <span class="dimmer">·</span>
        <span class="mono dimmer">not affiliated with github, inc.</span>
      </div>
    </div>
  </div>
</footer>

