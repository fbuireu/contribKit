---
import '../styles/components/footer.css';
import pkg from '../../../package.json';
import IconGitHub from './icons/IconGitHub.astro';
import IconApple from './icons/IconApple.astro';
import IconPlayStore from './icons/IconPlayStore.astro';
---

<footer class="footer">
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <img src="/logo.svg" width="28" height="28" alt="" aria-hidden="true" style="border-radius:6px" />
        <span class="brand-name">ContribKit</span>
      </div>
      <div class="foot-links">
        <a href="https://github.com/fbuireu/contribkit" class="foot-link" target="_blank" rel="noopener noreferrer">
          <IconGitHub />
          github
        </a>
        <a href="#" class="foot-link">
          <IconApple />
          app store
        </a>
        <a href="#" class="foot-link">
          <IconPlayStore />
          play store
        </a>
      </div>
    </div>
    <div class="foot-bot">
      <span class="mono dimmer">© 2026 contribkit · v{pkg.version}</span>
      <div class="foot-legal">
        <a href="/privacy" class="legal-link mono">privacy</a>
        <span class="dimmer">·</span>
        <a href="/terms" class="legal-link mono">terms</a>
        <span class="dimmer">·</span>
        <span class="mono dimmer">not affiliated with github, inc.</span>
      </div>
    </div>
  </div>
</footer>

