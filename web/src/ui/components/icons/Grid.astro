---
interface Props {
  class?: string;
  width?: number | string;
  height?: number | string;
}
const { class: className, width = 15, height = 15 } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 20 20"
  width={width}
  height={height}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden="true"
>
  <rect x="2" y="2" width="7" height="7" rx="1.5" />
  <rect x="11" y="2" width="7" height="7" rx="1.5" />
  <rect x="2" y="11" width="7" height="7" rx="1.5" />
  <rect x="11" y="11" width="7" height="7" rx="1.5" />
</svg>
