---
interface Props {
  class?: string;
  width?: number | string;
  height?: number | string;
  fill?: string;
}
const { class: className, width = 9, height = 11, fill = 'var(--g-3)' } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 12 14"
  width={width}
  height={height}
  fill="none"
  aria-hidden="true"
>
  <path d="M6 1C4 5 2 6.5 2 9a4 4 0 0 0 8 0c0-2.5-1.5-4-2-6C7.5 5 7.5 6 6 7 5.2 6 5 4.5 6 1z" fill={fill} stroke="none" />
