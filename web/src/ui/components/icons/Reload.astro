---
interface Props {
	class?: string;
	width?: number | string;
	height?: number | string;
}
const { class: className, width = 14, height = 14 } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 16 16"
  width={width}
  height={height}
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  aria-hidden="true"
>
  <path d="M13.6 8a5.6 5.6 0 1 1-1.7-4" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M12.5 1.5v3h-3" stroke-linecap="round" stroke-linejoin="round" />
</svg>
