---
interface Props {
  class?: string;
  width?: number | string;
  height?: number | string;
}
const { class: className, width = 15, height = 15 } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 20 20"
  width={width}
  height={height}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden="true"
>
  <path d="M4 10h2m4-4v2m4 2h2m-6 4v2" stroke-linecap="round" />
  <circle cx="10" cy="10" r="7.5" />
</svg>
