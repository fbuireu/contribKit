---
interface Props {
	class?: string;
	width?: number | string;
	height?: number | string;
}
const { class: className, width = 14, height = 14 } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 16 16"
  width={width}
  height={height}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden="true"
>
  <rect x="5" y="5" width="9" height="9" rx="1.5" />
  <path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" />
</svg>
