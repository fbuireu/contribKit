---
import "./top-nav.css";
import Download from "./icons/Download.astro";
import Moon from "./icons/Moon.astro";
import Sun from "./icons/Sun.astro";
---

<nav class="topnav">
  <div class="wrap topnav-wrap">
    <a class="brand" href="/"  aria-label="ContribKit home">
      <img src="/logo.svg" width="28" height="28" alt="" aria-hidden="true" style="border-radius:0.375rem" />
      <span class="brand-name">ContribKit</span>
    </a>
    <div class="nav-links">
      <a href="/#how">how it works</a>
      <a href="/#custom">customize</a>
      <a href="/#export">export</a>
      <a href="/#widget">widget</a>
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Switch to dark mode"
        aria-pressed="false"
        title="Toggle theme"
      >
        <Sun class="ti sun" />
        <Moon class="ti moon" />
      </button>
      <button type="button" class="nav-cta">
        <Download />
        get app
      </button>
    </div>
  </div>
</nav>

<script>
  import { initThemeToggle } from '../lib/theme-toggle';
  initThemeToggle();
</script>
