---
import "./top-nav.css";
import Download from "./icons/Download.astro";
import Moon from "./icons/Moon.astro";
import Sun from "./icons/Sun.astro";

const base = Astro.url.pathname === "/" ? "" : "/";
---

<nav class="topnav">
  <div class="wrap topnav-wrap">
    <a class="brand" href="/" data-astro-prefetch="false" aria-label="ContribKit home">
      <img src="/logo.svg" width="28" height="28" alt="" aria-hidden="true" style="border-radius:0.375rem" />
      <span class="brand-name">ContribKit</span>
    </a>
    <div class="nav-links">
      <a class="link-action" href={`${base}#how`} data-section="how" data-astro-prefetch="false">how it works</a>
      <a class="link-action" href={`${base}#custom`} data-section="custom" data-astro-prefetch="false">customize</a>
      <a class="link-action" href={`${base}#export`} data-section="export" data-astro-prefetch="false">export</a>
      <a class="link-action" href={`${base}#widget`} data-section="widget" data-astro-prefetch="false">widget</a>
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Switch to dark mode"
        aria-pressed="false"
        title="Toggle theme"
      >
        <Sun class="ti sun" />
        <Moon class="ti moon" />
      </button>
      <button type="button" class="nav-cta">
        <Download />
        get app
      </button>
    </div>
  </div>
</nav>

<script>
  import { initThemeToggle } from '../lib/theme-toggle';
  initThemeToggle();
</script>
