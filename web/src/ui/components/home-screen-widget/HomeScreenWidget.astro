---
import { ClassName, ElementId } from "../../utils/dom-contract";
import "./home-screen-widget.css";
import type { ContributionStats } from "@domain/services/contribution-stats";
import { PALETTES } from "@domain/value-objects/palette";
import { formatHomeScreenWidgetTotal, formatStreak } from "../grid/contribution";
import { generateMiniGrid } from "../grid/mini-grid";
import Clock from "../icons/Clock.astro";
import Flame from "../icons/Flame.astro";
import Grid from "../icons/Grid.astro";
import Palette from "../icons/Palette.astro";
import Phone from "../icons/Phone.astro";

interface Props {
	stats: ContributionStats;
	username: string;
}
const { stats, username } = Astro.props;

const miniGrid = generateMiniGrid({ palette: PALETTES.github.colors });
const streak = formatStreak(stats.currentStreak);
---

<section class="section" id={ElementId.HomeScreenWidgetSection} aria-label="Home screen widget">
  <div class="wrap">
    <div class="eyebrow" aria-hidden="true"><span class="mono">home screen widget</span></div>
    <h2 class="section-title">
      Your streak.<br />
      <span class="dim">Always on your home screen.</span>
    </h2>

    <div class="widget-layout">

      <div class="phone-wrap" aria-label="Home screen widget preview">
        <div class="phone">
          <div class="phone-pill" aria-hidden="true"></div>
          <div class="phone-screen" id={ElementId.PhoneScreen}>
            <div class="home-glow" aria-hidden="true"></div>
            <div class="home-widgets">
              <div class="w-card w-medium" role="img" aria-label="Medium home screen widget showing contribution grid">
                <div class="w-head">
                  <span class="mono w-name" id={ElementId.HomeScreenWidgetUsername}>{username}</span>
                  <span class="w-streak">
                    <Flame />
                    <span class:list={["mono", ClassName.HomeScreenWidgetStreak]}>{streak}</span>
                  </span>
                </div>
                <div class="w-grid" id={ElementId.HomeScreenWidgetMiniGrid}>
                  <Fragment set:html={miniGrid} />
                </div>
                <div class="w-foot mono" id={ElementId.HomeScreenWidgetTotal}>{formatHomeScreenWidgetTotal(stats.totalContributions)}</div>
              </div>

              <div class="home-row">
                <div class="w-card w-small" role="img" aria-label="Small home screen widget showing streak count">
                  <div class:list={["ws-count", "mono", ClassName.HomeScreenWidgetStreak]}>{streak}</div>
                  <div class="ws-label mono">day streak</div>
                </div>
                <div class="app-icons" aria-hidden="true">
                  <span class="app-icon"></span>
                  <span class="app-icon"></span>
                  <span class="app-icon"></span>
                  <span class="app-icon ai-accent"></span>
                </div>
              </div>
            </div>
          </div>
          <div class="phone-bar" aria-hidden="true"></div>
        </div>
      </div>

      <div class="feat-list">
        <div class="feat">
          <div class="feat-icon">
            <Phone />
          </div>
          <div class="feat-text">
            <h3 class="feat-title">Android</h3>
            <p class="feat-body">A native home screen widget that follows Android's home screen widget conventions and size grid.</p>
          </div>
        </div>
        <div class="feat">
          <div class="feat-icon">
            <Grid />
          </div>
          <div class="feat-text">
            <h3 class="feat-title">Three sizes</h3>
            <p class="feat-body">Small for a glanceable streak counter. Medium for the full calendar grid. Large for both at once.</p>
          </div>
        </div>
        <div class="feat">
          <div class="feat-icon">
            <Clock />
          </div>
          <div class="feat-text">
            <h3 class="feat-title">Daily refresh</h3>
            <p class="feat-body">Fetches once a day so the grid is always current without draining the battery.</p>
          </div>
        </div>
        <div class="feat">
          <div class="feat-icon">
            <Palette />
          </div>
          <div class="feat-text">
            <h3 class="feat-title">All palettes</h3>
            <p class="feat-body">All {Object.keys(PALETTES).length} color palettes available. The home screen widget matches whatever you set in the app.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

