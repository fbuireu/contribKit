---
import { mulberry32 } from "@ui/utils/mulberry";
import "./contribution-code.css";
import { digitsToMatrix, noiseLevel } from "./glyph-utils";

interface Props {
	digits: string;
	seed?: number;
}

const { digits, seed = 3 } = Astro.props;

const matrix = digitsToMatrix(digits);
const columns = matrix[0]?.length ?? 0;
const CELL_SIZE = 18;
const CELL_GAP = 5;
const CELL_STEP = CELL_SIZE + CELL_GAP;
const width = columns * CELL_STEP - CELL_GAP;
const height = matrix.length * CELL_STEP - CELL_GAP;

interface Square {
	x: number;
	y: number;
	className: string;
}

const random = mulberry32(seed);
const background: Square[] = [];
const glyph: Square[] = [];
matrix.forEach((cells, rowIndex) => {
	cells.forEach((isFilled, colIndex) => {
		const square = { x: colIndex * CELL_STEP, y: rowIndex * CELL_STEP, className: "" };
		if (isFilled) {
			glyph.push(square);
		} else {
			const level = noiseLevel(random());
			square.className = level === 0 ? "cc-empty" : level === 1 ? "cc-spark-1" : "cc-spark-2";
			background.push(square);
		}
	});
});
---

<svg
  class="contribution-code"
  viewBox={`0 0 ${width} ${height}`}
  width="100%"
  role="img"
  aria-label={`Status code ${digits}, drawn as an empty contribution grid`}
>
  {
    background.map((square) => (
      <rect class={square.className} x={square.x} y={square.y} width={CELL_SIZE} height={CELL_SIZE} rx="4" />
    ))
  }
  <g class="cc-glyph">
    {glyph.map((square) => <rect x={square.x} y={square.y} width={CELL_SIZE} height={CELL_SIZE} rx="4" />)}
  </g>
</svg>
