---
import "./error-view.css";
import ContributionCode from "./ContributionCode.astro";
import { type TerminalLine, TerminalLineKind } from "./terminal-line";

interface Props {
	code: number;
	tone?: "accent" | "danger";
	eyebrow: string;
	title: string;
	message: string;
	terminal: TerminalLine[];
	primary: { href: string; label: string; icon: "back" | "reload" };
	reportUrl?: string;
}

const {
	code,
	tone = "accent",
	eyebrow,
	title,
	message,
	terminal,
	primary,
	reportUrl = "https://github.com/fbuireu/contribkit/issues/new?template=bug_report.yml",
} = Astro.props;

const seed = code === 500 ? 7 : 3;
---

<section class:list={["error-page", { "is-danger": tone === "danger" }]} aria-labelledby="error-title">
  <div class="error-glow" aria-hidden="true"></div>
  <div class="error-texture" aria-hidden="true"></div>

  <div class="error-main wrap">
    <div class="error-gridwrap">
      <ContributionCode digits={String(code)} seed={seed} />
    </div>

    <p class="error-eyebrow mono">{eyebrow}</p>
    <h1 class="error-title" id="error-title">{title}</h1>
    <p class="error-msg dim">{message}</p>

    <div class="error-terminal mono">
      <div class="error-term-bar">
        <span class="error-term-dot" aria-hidden="true"></span>
        <span class="error-term-dot" aria-hidden="true"></span>
        <span class="error-term-dot" aria-hidden="true"></span>
        <span class="error-term-path">~/contribkit · render.log</span>
      </div>
      <div class="error-term-body">
        {
          terminal.map((line) => (
            <p class="error-term-line">
              <span class="error-term-prompt" aria-hidden="true">{line.kind === TerminalLineKind.Command ? "$" : " "}</span>
              <span class:list={["error-term-text", `is-${line.kind}`]}>{line.text}</span>
            </p>
          ))
        }
        <p class="error-term-line" aria-hidden="true">
          <span class="error-term-prompt">$</span>
          <span class="error-term-cursor"></span>
        </p>
      </div>
    </div>

    <div class="error-actions">
      <a class="error-btn error-btn-primary" href={primary.href}>
        {
          primary.icon === "reload" ? (
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M13.6 8a5.6 5.6 0 1 1-1.7-4" />
              <path d="M12.5 1.5v3h-3" />
            </svg>
          ) : (
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M13 8H3M7 4L3 8l4 4" />
            </svg>
          )
        }
        {primary.label}
      </a>
      <a class="error-btn error-btn-ghost" href={reportUrl} target="_blank" rel="noopener noreferrer">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
        Report issue
      </a>
    </div>
  </div>
</section>
