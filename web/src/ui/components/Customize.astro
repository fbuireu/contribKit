---
import '../styles/components/customize.css';
import { PALETTES } from '../../domain/value-objects/palette';
import { SHAPE_KINDS } from '../../domain/value-objects/shape';

const paletteCount = Object.keys(PALETTES).length;
const shapeCount = SHAPE_KINDS.length;
---

<section class="section" id="custom">
  <div class="wrap">
    <div class="eyebrow"><span class="mono">customize</span></div>
    <h2 class="section-title">
      Make it look like<br />
      <span class="dim">something you'd actually pin.</span>
    </h2>
    <div class="custom-grid">
      <div class="custom-preview">
        <div class="preview-frame" id="custom-grid-container" aria-live="polite" aria-label="Calendar preview"></div>
        <div class="preview-meta">
          <span class="mono dim">palette</span>
          <span class="mono" id="custom-palette-label">classic</span>
          <span class="mono dimmer">/</span>
          <span class="mono dim">shape</span>
          <span class="mono" id="custom-shape-label">rounded</span>
        </div>
      </div>
      <div class="custom-controls">
        <div class="ctrl-group">
          <div class="ctrl-label">
            <span class="mono dim">palette</span>
            <span class="mono dimmer">{paletteCount}</span>
          </div>
          <div class="palette-list" id="palette-list" role="radiogroup" aria-label="Color palette"></div>
        </div>
        <div class="ctrl-group">
          <div class="ctrl-label">
            <span class="mono dim">shape</span>
            <span class="mono dimmer">{shapeCount}</span>
          </div>
          <div class="shape-list" id="shape-list" role="radiogroup" aria-label="Cell shape"></div>
        </div>
      </div>
    </div>
  </div>
</section>

