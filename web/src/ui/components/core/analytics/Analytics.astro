---
import { ANALYTICS_CATEGORY, CONSENT_COOKIE_NAME } from "../cookie-consent/config";

const GA_ID = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID;
---

<script is:inline define:vars={{ GA_ID, CONSENT_COOKIE_NAME, ANALYTICS_CATEGORY }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  window.gtag = gtag;

  const consentPattern = new RegExp('(^| )' + CONSENT_COOKIE_NAME + '=([^;]+)');

  const analyticsConsent = (() => {
    try {
      const match = document.cookie.match(consentPattern);
      if (match) {
        const data = JSON.parse(decodeURIComponent(match[2]));
        return Array.isArray(data.categories) && data.categories.includes(ANALYTICS_CATEGORY) ? 'granted' : 'denied';
      }
    } catch {}
    return 'denied';
  })();

  gtag('consent', 'default', { analytics_storage: analyticsConsent });
  gtag('js', new Date());
  gtag('config', GA_ID);
</script>

<script>
  import { acceptedService } from "vanilla-cookieconsent";
  import { getAnalytics } from "@ui/components/core/analytics/analytics";

  function applyConsent() {
    const analytics = getAnalytics();
    const googleGranted = acceptedService("ga4", "analytics");
    analytics.syncGoogleConsent(googleGranted);
    if (googleGranted) analytics.loadGoogleAnalytics();
    if (acceptedService("betterstack", "analytics")) analytics.loadBetterStack();
  }

  applyConsent();
  window.addEventListener("cc:onConsent", applyConsent);
  window.addEventListener("cc:onChange", applyConsent);
</script>
