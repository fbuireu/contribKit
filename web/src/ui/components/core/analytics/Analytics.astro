---
const GA_ID = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID;
---

<script is:inline define:vars={{ GA_ID }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  window.gtag = gtag;

  const analyticsConsent = (() => {
    try {
      const match = document.cookie.match(/(^| )cc_cookie=([^;]+)/);
      if (match) {
        const data = JSON.parse(decodeURIComponent(match[2]));
        return Array.isArray(data.categories) && data.categories.includes('analytics') ? 'granted' : 'denied';
      }
    } catch {}
    return 'denied';
  })();

  gtag('consent', 'default', { analytics_storage: analyticsConsent });
  gtag('js', new Date());
  gtag('config', GA_ID);
</script>
<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>

<script>
  import { acceptedService } from "vanilla-cookieconsent";
  import { getAnalytics } from "@ui/components/core/analytics/analytics";

  function applyConsent() {
    const analytics = getAnalytics();
    analytics.syncGoogleConsent(acceptedService("ga4", "analytics"));
    if (acceptedService("betterstack", "analytics")) analytics.loadBetterStack();
  }

  applyConsent();
  window.addEventListener("cc:onConsent", applyConsent);
  window.addEventListener("cc:onChange", applyConsent);
</script>
