---
import "../../../styles/index.css";
import Font from "astro/components/Font.astro";
import { ClassName, ElementId, ThemeClass } from "../../../utils/dom-contract";
import CookieConsent from "../cookie-consent/CookieConsent.astro";
import Footer from "../footer/Footer.astro";
import Header from "../header/Header.astro";
import { COLOR_SCHEME_KEY, COLOR_SCHEME_META_SELECTOR } from "../header/theme-toggle";
import SEO from "../seo/SEO.astro";
import type { Metadata } from "../seo/types";
import Telemetry from "../telemetry/Telemetry.astro";
import { ThemeChoice } from "../telemetry/usage-event";

interface Props {
	metadata: Metadata;
}

const { metadata } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="text-scale" content="scale" />
    <meta name={COLOR_SCHEME_KEY} content="light dark" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <script is:inline define:vars={{ COLOR_SCHEME_KEY, COLOR_SCHEME_META_SELECTOR, ThemeClass, ThemeChoice }}>
      const pinnedScheme = localStorage.getItem(COLOR_SCHEME_KEY);
      if (pinnedScheme === ThemeChoice.Light || pinnedScheme === ThemeChoice.Dark) {
        document.documentElement.classList.add(pinnedScheme === ThemeChoice.Light ? ThemeClass.Light : ThemeClass.Dark);
        document.querySelector(COLOR_SCHEME_META_SELECTOR).content = pinnedScheme;
      }
    </script>
    <SEO metadata={metadata} />
    <Telemetry />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    <a href={`#${ElementId.MainContent}`} class={ClassName.SkipLink}>Skip to main content</a>
    <Header />
    <main id={ElementId.MainContent}>
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>
