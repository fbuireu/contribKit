---
import "@ui/styles/index.css";
import Font from "astro/components/Font.astro";
import Analytics from "../analytics/Analytics.astro";
import CookieConsent from "../cookie-consent/CookieConsent.astro";
import Footer from "../footer/Footer.astro";
import Header from "../header/Header.astro";
import SEO from "../seo/SEO.astro";
import type { Metadata } from "../seo/types";

interface Props {
	metadata: Metadata;
}

const { metadata } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      {
        const colorScheme = localStorage.getItem('color-scheme');
        if (colorScheme === 'light' || colorScheme === 'dark') {
          document.documentElement.classList.add(`theme-${colorScheme}`);
          document.querySelector('meta[name="color-scheme"]').content = colorScheme;
        }
      }
    </script>
    <SEO metadata={metadata} />
    <Analytics />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>
