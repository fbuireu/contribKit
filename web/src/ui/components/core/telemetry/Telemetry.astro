---
import { CONSENT_COOKIE_NAME, ConsentCategory } from "../cookie-consent/config";
import { GoogleConsentState } from "./telemetry";

const GA_ID = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID;
---

<script is:inline define:vars={{ GA_ID, CONSENT_COOKIE_NAME, ConsentCategory, GoogleConsentState }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  window.gtag = gtag;

  const consentPattern = new RegExp('(^| )' + CONSENT_COOKIE_NAME + '=([^;]+)');

  const analyticsConsent = (() => {
    try {
      const match = document.cookie.match(consentPattern);
      if (match) {
        const data = JSON.parse(decodeURIComponent(match[2]));
        return Array.isArray(data.categories) && data.categories.includes(ConsentCategory.Analytics)
          ? GoogleConsentState.Granted
          : GoogleConsentState.Denied;
      }
    } catch {}
    return GoogleConsentState.Denied;
  })();

  gtag('consent', 'default', { analytics_storage: analyticsConsent });
  gtag('js', new Date());
  gtag('config', GA_ID);
</script>

<script>
  import { initTelemetry } from "./telemetry";
  import { initUsageEventLinks } from "./usage-event-links";

  initTelemetry();
  initUsageEventLinks();
</script>
