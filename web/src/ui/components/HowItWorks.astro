---
import '../styles/components/how-it-works.css';
import IconCopy from './icons/IconCopy.astro';
import IconDownload from './icons/IconDownload.astro';
---

<section class="section" id="how">
  <div class="wrap">
    <div class="eyebrow"><span class="mono">flow</span></div>
    <h2 class="section-title">Four taps.<br /><span class="dim">Nothing else to learn.</span></h2>
    <div class="steps">

      <div class="step">
        <div class="step-head">
          <span class="mono step-n" aria-hidden="true"></span>
          <span class="step-rule" aria-hidden="true"></span>
        </div>
        <div class="step-glyph step-input" aria-hidden="true">
          <div class="mono dimmer">$</div>
          <div class="mono">contribKit <span class="accent">@torvalds</span></div>
          <div class="cursor"></div>
        </div>
        <h3 class="step-title">Enter username</h3>
        <p class="step-body">No OAuth, no personal access token. Just your handle.</p>
      </div>

      <div class="step">
        <div class="step-head">
          <span class="mono step-n" aria-hidden="true"></span>
          <span class="step-rule" aria-hidden="true"></span>
        </div>
        <div class="step-glyph step-customize" aria-hidden="true">
          <div class="chip-row">
            <span class="chip" style="background:#39D353"></span>
            <span class="chip" style="background:#7fb0ff"></span>
            <span class="chip" style="background:#f0a45a"></span>
            <span class="chip" style="background:#c8a8ff"></span>
          </div>
          <div class="shape-row">
            <span class="shape-tile sq"></span>
            <span class="shape-tile circ"></span>
            <span class="shape-tile dot"><i></i></span>
            <span class="shape-tile hex"></span>
          </div>
        </div>
        <h3 class="step-title">Customize</h3>
        <p class="step-body">Six palettes. Five shapes. Background, gradient, intensity, density.</p>
      </div>

      <div class="step">
        <div class="step-head">
          <span class="mono step-n" aria-hidden="true"></span>
          <span class="step-rule" aria-hidden="true"></span>
        </div>
        <div class="step-glyph step-export" aria-hidden="true">
          <div class="export-pill">
            <span class="mono">.png</span>
            <IconDownload />
          </div>
          <div class="export-pill">
            <span class="mono">.svg</span>
            <IconCopy />
          </div>
          <div class="export-pill">
            <span class="mono">.md</span>
            <IconCopy />
          </div>
        </div>
        <h3 class="step-title">Export</h3>
        <p class="step-body">PNG for the readme. SVG for the portfolio. Markdown for the bio.</p>
      </div>

      <div class="step">
        <div class="step-head">
          <span class="mono step-n" aria-hidden="true"></span>
          <span class="step-rule" aria-hidden="true"></span>
        </div>
        <div class="step-glyph step-widget" aria-hidden="true">
          <div class="widget-mock">
            <div class="wm-bar">
              <span class="wm-dot"></span>
              <span class="wm-user mono" id="how-widget-username">torvalds</span>
            </div>
            <div class="wm-cells">
              {Array.from({ length: 12 * 7 }, (_, i) => {
                const lvl = [0,0,1,0,2,1,0,3,1,0,2,4,1,0,1,2,0,3,1,0,1,0,2,1,3,2,0,1,0,0,2,0,1,3,2,1,0,1,0,2,3,1,0,1,0,2,1,0,0,3,2,1,0,1,2,0,1,3,0,2,1,0,1,2,3,0,1,2,0,1,3,2,0,1,0,1,2,3,4,2,1,0,1,2][i % 84];
                return <span class="wm-cell" data-level={lvl}></span>;
              })}
            </div>
            <div class="wm-foot mono">42 day streak</div>
          </div>
        </div>
        <h3 class="step-title">Pin the widget</h3>
        <p class="step-body">Add the home screen widget and your contribution streak is always one glance away.</p>
      </div>

    </div>
  </div>
</section>

