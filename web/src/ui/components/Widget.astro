---
import '../styles/components/widget.css';
import IconFlame from './icons/IconFlame.astro';
import IconPhone from './icons/IconPhone.astro';
import IconGrid from './icons/IconGrid.astro';
import IconClock from './icons/IconClock.astro';
import IconPalette from './icons/IconPalette.astro';
import { mulberry32 } from '../lib/mulberry';

// Mini contribution grid for the phone mockup
const pal = ['#161b22', '#0E4429', '#006D32', '#26A641', '#39D353'];

const rand = mulberry32(99);
const COLS = 26, ROWS = 7;
const cells: number[] = Array.from({ length: COLS * ROWS }, (_, i) => {
  const r = rand();
  const progress = (Math.floor(i / ROWS)) / COLS;
  const boosted = r + progress * 0.3 + Math.sin(i / 8) * 0.15;
  if (boosted > 0.92) return 4;
  if (boosted > 0.78) return 3;
  if (boosted > 0.62) return 2;
  if (boosted > 0.42) return 1;
  return 0;
});

const sz = 4, gap = 1, step = sz + gap;
const svgW = COLS * step, svgH = ROWS * step;
let miniGrid = `<svg width="${svgW}" height="${svgH}" viewBox="0 0 ${svgW} ${svgH}" xmlns="http://www.w3.org/2000/svg">`;
for (let w = 0; w < COLS; w++) {
  for (let d = 0; d < ROWS; d++) {
    const level = cells[w * ROWS + d];
    miniGrid += `<rect x="${w * step}" y="${d * step}" width="${sz}" height="${sz}" rx="1" fill="${pal[level]}"/>`;
  }
}
miniGrid += '</svg>';
---

<section class="section" id="widget">
  <div class="wrap">
    <div class="eyebrow"><span class="mono">widget</span></div>
    <h2 class="section-title">
      Your streak.<br />
      <span class="dim">Always on your home screen.</span>
    </h2>

    <div class="widget-layout">

      <div class="phone-wrap" aria-label="Home screen widget preview">
        <div class="phone">
          <div class="phone-pill" aria-hidden="true"></div>
          <div class="phone-screen">
            <div class="home-glow" aria-hidden="true"></div>
            <div class="home-widgets">
              <div class="w-card w-medium" role="img" aria-label="Medium widget showing contribution grid">
                <div class="w-head">
                  <span class="mono w-name">torvalds</span>
                  <span class="w-streak">
                    <IconFlame />
                    <span class="mono">42</span>
                  </span>
                </div>
                <div class="w-grid">
                  <Fragment set:html={miniGrid} />
                </div>
                <div class="w-foot mono">1,234 contributions this year</div>
              </div>

              <div class="home-row">
                <div class="w-card w-small" role="img" aria-label="Small widget showing streak count">
                  <div class="ws-count mono">42</div>
                  <div class="ws-label mono">day streak</div>
                </div>
                <div class="app-icons" aria-hidden="true">
                  <span class="app-icon"></span>
                  <span class="app-icon"></span>
                  <span class="app-icon"></span>
                  <span class="app-icon ai-accent"></span>
                </div>
              </div>
            </div>
          </div>
          <div class="phone-bar" aria-hidden="true"></div>
        </div>
      </div>

      <div class="feat-list">
        <div class="feat">
          <div class="feat-icon">
            <IconPhone />
          </div>
          <div class="feat-text">
            <div class="feat-title">iOS &amp; Android</div>
            <p class="feat-body">Native home screen widget for both platforms. Follows each OS's widget conventions and size grid.</p>
          </div>
        </div>
        <div class="feat">
          <div class="feat-icon">
            <IconGrid />
          </div>
          <div class="feat-text">
            <div class="feat-title">Three sizes</div>
            <p class="feat-body">Small for a glanceable streak counter. Medium for the full calendar grid. Large for both at once.</p>
          </div>
        </div>
        <div class="feat">
          <div class="feat-icon">
            <IconClock />
          </div>
          <div class="feat-text">
            <div class="feat-title">Daily refresh</div>
            <p class="feat-body">Fetches once a day so the grid is always current without draining the battery.</p>
          </div>
        </div>
        <div class="feat">
          <div class="feat-icon">
            <IconPalette />
          </div>
          <div class="feat-text">
            <div class="feat-title">All palettes</div>
            <p class="feat-body">All 11 color palettes available. The widget matches whatever you set in the app.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

