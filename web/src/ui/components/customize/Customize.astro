---
import "./customize.css";
import { PALETTES } from "@domain/value-objects/palette";
import { SHAPE_KINDS } from "@domain/value-objects/shape";
import { shapePreviewSVG } from "@ui/components/grid/render-svg";
import ArrowRight from "@ui/components/icons/ArrowRight.astro";

const palettes = Object.values(PALETTES);
---

<section class="section" id="custom" aria-label="Customize">
  <div class="wrap">
    <div class="eyebrow" aria-hidden="true"><span class="mono">customize</span></div>
    <h2 class="section-title">
      Make it look like<br />
      <span class="dim">something you'd actually pin.</span>
    </h2>
    <div class="custom-grid">
      <div class="custom-preview">
        <div class="preview-frame" id="custom-grid-container" aria-live="polite" aria-label="Calendar preview"></div>
        <div class="preview-meta">
          <span class="mono dim">palette</span>
          <span class="mono" id="custom-palette-label">github</span>
          <span class="mono dimmer">/</span>
          <span class="mono dim">shape</span>
          <span class="mono" id="custom-shape-label">rounded</span>
        </div>
      </div>
      <div class="custom-controls">
        <div class="ctrl-group">
          <div class="ctrl-label">
            <span class="mono dim">palette</span>
            <span class="mono dimmer">{palettes.length}</span>
          </div>
          <div class="palette-list" id="palette-list" role="radiogroup" aria-label="Color palette">
            {palettes.map(({ key, name, colors }, index) => (
              <button
                class:list={['palette-row', { active: index === 0 }]}
                role="radio"
                aria-checked={index === 0 ? 'true' : 'false'}
                data-key={key}
              >
                <span class="palette-swatches">
                  {colors.map((color) => <span style={`background:${color}`} />)}
                </span>
                <span class="palette-name mono">{name}</span>
                <span class="palette-check"><ArrowRight /></span>
              </button>
            ))}
          </div>
        </div>
        <div class="ctrl-group">
          <div class="ctrl-label">
            <span class="mono dim">shape</span>
            <span class="mono dimmer">{SHAPE_KINDS.length}</span>
          </div>
          <div class="shape-list" id="shape-list" role="radiogroup" aria-label="Cell shape">
            {SHAPE_KINDS.map((kind, index) => (
              <button
                class:list={['shape-btn', { active: index === 0 }]}
                role="radio"
                aria-checked={index === 0 ? 'true' : 'false'}
                data-key={kind}
              >
                <Fragment set:html={shapePreviewSVG(kind)} />
                <span class="mono">{kind}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
