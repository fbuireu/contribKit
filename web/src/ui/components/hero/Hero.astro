---
import type { PaletteColors } from "@domain/value-objects/palette";
import { MAX_USERNAME_LENGTH, SUGGESTED_USERNAMES } from "@domain/value-objects/username";
import { MIN_YEAR } from "@domain/value-objects/year";
import { ClassName, ElementId } from "../../utils/dom-contract";
import "./hero.css";
import type { ContributionStats } from "@domain/services/contribution-stats";
import { PLAY_STORE_URL } from "../../utils/app-links";
import { formatHeroError } from "../../utils/contribution-errors";
import { StoreLinkPlacement, StoreName, UsageEventName } from "../core/telemetry/usage-event";
import { usageEventAttributes } from "../core/telemetry/usage-event-links";
import { formatStreak, formatTotalContributions } from "../grid/contribution";
import AppStore from "../icons/AppStore.astro";
import ArrowRight from "../icons/ArrowRight.astro";
import ChevronDown from "../icons/ChevronDown.astro";
import GooglePlay from "../icons/GooglePlay.astro";

const appVersion = __APP_VERSION__;
const playStoreUsage = usageEventAttributes({
	event: UsageEventName.StoreLinkOpened,
	store: StoreName.Play,
	placement: StoreLinkPlacement.Hero,
});

interface Props {
	heroSVG: string;
	stats: ContributionStats;
	palette: PaletteColors;
	username: string;
	thisYear: number;
	year?: number;
	error?: string | null;
}
const { heroSVG, stats, palette, username, thisYear, year = thisYear, error = null } = Astro.props;
---

<section class={ClassName.Hero} aria-label="Hero">
  <div class="hero-grain" aria-hidden="true"></div>
  <div class="wrap">

    <div class="meta">
      <span class="badge">
        <span class="badge-dot" aria-hidden="true"></span>
        v{appVersion} · available on iOS &amp; Android
      </span>
    </div>

    <h1 class="display">
      Your GitHub activity.<br />
      <span class="display-accent">Your aesthetic.</span>
    </h1>
    <p class="lede">
      Visualize, customize, and export your contribution calendar &mdash; no token required.
    </p>

    <div class="cta-row">
      <button type="button" class="btn btn-store btn-store--soon" aria-label="App Store, coming soon" disabled aria-disabled="true">
        <AppStore />
        <span>
          <small>Coming soon to the</small>
          App Store
        </span>
      </button>
      <a href={PLAY_STORE_URL} class="btn btn-store" target="_blank" rel="noopener noreferrer" aria-label="Get it on Google Play" {...playStoreUsage}>
        <GooglePlay />
        <span>
          <small>Get it on</small>
          Google Play
        </span>
      </a>
    </div>

    <form id={ElementId.UsernameForm} role="search" aria-label="Render GitHub contributions">
      <div class="username-strip">
        <label for={ElementId.HeroUsername} class="us-label sr-only">GitHub username</label>
        <span class="us-label" aria-hidden="true">github.com/</span>
        <input class="us-input" id={ElementId.HeroUsername} type="search" value={username} maxlength={MAX_USERNAME_LENGTH} spellcheck="false" autocomplete="off" autocapitalize="none" autocorrect="off" />
        <div class="us-year-wrap">
          <select class="us-year" id={ElementId.HeroYear} aria-label="Year">
            {Array.from({ length: thisYear - MIN_YEAR + 1 }, (_, index) => thisYear - index).map(yearOption => (
              <option value={yearOption} selected={yearOption === year}>{yearOption}</option>
            ))}
          </select>
          <span class="us-year-chevron" aria-hidden="true">
            <ChevronDown />
          </span>
        </div>
        <button class="us-go" id={ElementId.HeroRenderButton} type="button">
          <span id={ElementId.HeroRenderLabel}>render</span>
          <ArrowRight />
        </button>
      </div>
    </form>

    <div class="suggestions" role="group" aria-label="Try a famous GitHub username">
      <span class="mono sug-label" aria-hidden="true">try:</span>
      {SUGGESTED_USERNAMES.map((suggestedUsername) => (
        <button class:list={[ClassName.SuggestionButton, "mono"]} data-username={suggestedUsername}>{suggestedUsername}</button>
      ))}
    </div>

    <p class="hero-error" id={ElementId.HeroError} aria-live="polite" hidden={!error}>{error ? formatHeroError(error) : ""}</p>

    <div class="hero-stage">
      <div class="hero-card">
        <div class="hero-card-bar">
          <div class="bar-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <div class="bar-title">
            <span class="mono dim" id={ElementId.HeroUsernameDisplay}>{username}</span>
            <span class="mono dimmer" aria-hidden="true">·</span>
            <span class="mono dim" id={ElementId.HeroYearRange}>last year</span>
          </div>
          <div class={ClassName.BarTag}>
            <span class="mono">{formatTotalContributions(stats.totalContributions)}</span> contributions
          </div>
        </div>
        <div class="hero-card-body" id={ElementId.HeroGrid}>
          <Fragment set:html={heroSVG} />
        </div>
        <div class="hero-card-foot">
          <div class={ClassName.Legend} role="img" aria-label="Contribution level: less to more">
            <span class="mono dimmer" aria-hidden="true">less</span>
            {palette.map((color) => (
              <span class={ClassName.LegendSquare} style={`background:${color.hex};border-radius:0.125rem`} aria-hidden="true"></span>
            ))}
            <span class="mono dimmer" aria-hidden="true">more</span>
          </div>
          <div class={ClassName.LegendStats}>
            <span><b class="mono">{formatStreak(stats.currentStreak)}</b> day streak</span>
            <span class={ClassName.Separator} aria-hidden="true">·</span>
            <span><b class="mono">{formatStreak(stats.longestStreak)}</b> longest</span>
          </div>
        </div>
      </div>
      <div class="hero-card-glow" aria-hidden="true"></div>
    </div>

  </div>
</section>
