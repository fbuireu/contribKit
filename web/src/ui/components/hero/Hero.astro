---
import { SUGGESTED_USERNAMES } from "@domain/value-objects/username";
import { MIN_YEAR } from "@domain/value-objects/year";
import { ElementId } from "@ui/utils/dom-contract";
import "./hero.css";
import type { ContributionStats } from "@domain/services/contribution-stats";
import { formatTotalContributions } from "@ui/components/grid/contribution";
import AppStore from "@ui/components/icons/AppStore.astro";
import ArrowRight from "@ui/components/icons/ArrowRight.astro";
import ChevronDown from "@ui/components/icons/ChevronDown.astro";
import GooglePlay from "@ui/components/icons/GooglePlay.astro";
import { PLAY_STORE_URL } from "@ui/utils/app-links";
import { formatHeroError } from "@ui/utils/contribution-errors";

const currentYear = new Date().getFullYear();
const appVersion = __APP_VERSION__;

interface Props {
	heroSVG: string;
	stats: ContributionStats;
	palette: readonly string[];
	username: string;
	year?: number;
	error?: string | null;
}
const { heroSVG, stats, palette, username, year = currentYear, error = null } = Astro.props;
---

<section class="hero" aria-label="Hero">
  <div class="hero-grain" aria-hidden="true"></div>
  <div class="wrap">

    <div class="meta">
      <span class="badge">
        <span class="badge-dot" aria-hidden="true"></span>
        v{appVersion} · available on iOS &amp; Android
      </span>
    </div>

    <h1 class="display">
      Your GitHub activity.<br />
      <span class="display-accent">Your aesthetic.</span>
    </h1>
    <p class="lede">
      Visualize, customize, and export your contribution calendar &mdash; no token required.
    </p>

    <div class="cta-row">
      <button type="button" class="btn btn-store btn-store--soon" aria-label="App Store — coming soon" disabled aria-disabled="true">
        <AppStore />
        <span>
          <small>Coming soon to the</small>
          App Store
        </span>
      </button>
      <a href={PLAY_STORE_URL} class="btn btn-store" target="_blank" rel="noopener noreferrer" aria-label="Get it on Google Play">
        <GooglePlay />
        <span>
          <small>Get it on</small>
          Google Play
        </span>
      </a>
    </div>

    <form id={ElementId.UsernameForm} role="search" aria-label="Render GitHub contributions">
      <div class="username-strip">
        <label for={ElementId.HeroUsername} class="us-label sr-only">GitHub username</label>
        <span class="us-label" aria-hidden="true">github.com/</span>
        <input class="us-input" id={ElementId.HeroUsername} type="search" value={username} spellcheck="false" autocomplete="off" autocapitalize="none" autocorrect="off" />
        <div class="us-year-wrap">
          <select class="us-year" id={ElementId.HeroYear} aria-label="Year">
            {Array.from({ length: currentYear - MIN_YEAR + 1 }, (_, index) => currentYear - index).map(yearOption => (
              <option value={yearOption} selected={yearOption === year}>{yearOption}</option>
            ))}
          </select>
          <span class="us-year-chevron" aria-hidden="true">
            <ChevronDown />
          </span>
        </div>
        <button class="us-go" id={ElementId.HeroRenderButton} type="button">
          <span id={ElementId.HeroRenderLabel}>render</span>
          <ArrowRight />
        </button>
      </div>
    </form>

    <div class="suggestions" role="group" aria-label="Try a famous GitHub profile">
      <span class="mono sug-label" aria-hidden="true">try:</span>
      {SUGGESTED_USERNAMES.map((handle) => (
        <button class="sug-btn mono" data-username={handle}>{handle}</button>
      ))}
    </div>

    <p class="hero-error" id={ElementId.HeroError} aria-live="polite" hidden={!error}>{error ? formatHeroError(error) : ""}</p>

    <div class="hero-stage">
      <div class="hero-card">
        <div class="hero-card-bar">
          <div class="bar-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <div class="bar-title">
            <span class="mono dim" id={ElementId.HeroUsernameDisplay}>{username}</span>
            <span class="mono dimmer" aria-hidden="true">·</span>
            <span class="mono dim" id={ElementId.HeroYearRange}>last year</span>
          </div>
          <div class="bar-tag">
            <span class="mono">{formatTotalContributions(stats.totalContributions)}</span> contributions
          </div>
        </div>
        <div class="hero-card-body" id={ElementId.HeroGrid}>
          <Fragment set:html={heroSVG} />
        </div>
        <div class="hero-card-foot">
          <div class="legend" role="img" aria-label="Contribution level: less to more">
            <span class="mono dimmer" aria-hidden="true">less</span>
            {palette.map((color) => (
              <span class="legend-sq" style={`background:${color};border-radius:0.125rem`} aria-hidden="true"></span>
            ))}
            <span class="mono dimmer" aria-hidden="true">more</span>
          </div>
          <div class="legend-stats">
            <span><b class="mono">{stats.currentStreak}</b> day streak</span>
            <span class="sep" aria-hidden="true">·</span>
            <span><b class="mono">{stats.longestStreak}</b> longest</span>
          </div>
        </div>
      </div>
      <div class="hero-card-glow" aria-hidden="true"></div>
    </div>

  </div>
</section>
