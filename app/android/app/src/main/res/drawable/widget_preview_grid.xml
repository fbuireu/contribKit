<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: dark canvas matching contribution grid zero-level -->
    <item>
        <shape>
            <solid android:color="#0D1117" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <!-- Simulated heatmap: left = sparse, right = dense green -->
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#00000000"
                android:centerColor="#3539D353"
                android:endColor="#8039D353"
                android:type="linear" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>
