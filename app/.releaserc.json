{
  "extends": "semantic-release-monorepo",
  "branches": ["main"],
  "tagFormat": "app-v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sed -i \"s/^version: .*/version: ${nextRelease.version}+$GITHUB_RUN_NUMBER/\" pubspec.yaml"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["pubspec.yaml", "CHANGELOG.md"],
        "message": "chore(release): app ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
